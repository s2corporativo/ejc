#!/usr/bin/env bash
# Hook de pre-push do EJC — valida localmente antes de enviar a branch.
# Ativação única na cópia de desenvolvimento:
#   git config core.hooksPath .githooks
#
# O modo padrão é "full": governança local + release P0 + inventário + backend
# completo + eval + frontend. Para uma rodada de paridade máxima com continuidade
# e navegador real, use EJC_PREPUSH_MODE=parity.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="${EJC_PREPUSH_MODE:-full}"

# Reuso explícito só quando a cópia já possui dependências íntegras. O default
# deixa o ci-local decidir/instalar o necessário, priorizando reprodutibilidade.
export CI_SKIP_PIP="${CI_SKIP_PIP:-0}"
export EJC_SKIP_NPM_CI="${EJC_SKIP_NPM_CI:-0}"

echo "[pre-push] executando CI local (modo: $MODE)"
if ! "$ROOT/scripts/ci-local.sh" "$MODE"; then
  echo "[pre-push] CI local FALHOU — push abortado. Corrija a causa; não use bypass no fluxo autônomo." >&2
  exit 1
fi

echo "[pre-push] CI local OK — seguindo com o push."
