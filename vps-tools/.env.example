# vps-tools/.env.example
# Copie este arquivo para vps-tools/.env e preencha com os valores REAIS.
# O arquivo vps-tools/.env NUNCA deve ser versionado (já está no .gitignore).
#
# Credenciais de acesso SSH/SFTP à VPS usadas por run.js, upload.js, sync.js,
# pull-file.js, deploy-rebrand.js e trocar-senha-root.js.

VPS_HOST=
VPS_USER=root
VPS_PORT=22

# Autenticação — configure PELO MENOS UMA das duas formas abaixo.
# Recomendado: as duas. Depender só de senha cria ponto único de falha; se ela
# for trocada ou perdida, o acesso só volta pelo painel do provedor (com reboot).

# 1) Senha
VPS_PASSWORD=

# 2) Chave SSH (preferida quando presente; a senha vira fallback)
#    Informe o caminho do arquivo de chave privada...
VPS_SSH_KEY_PATH=
#    ...ou a chave literal, se preferir mantê-la só em variável de ambiente.
VPS_SSH_KEY=
#    Passphrase da chave, quando houver.
VPS_SSH_PASSPHRASE=
