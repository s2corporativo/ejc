# vps-tools/.env.example
# Copie este arquivo para vps-tools/.env e preencha localmente.
# O arquivo vps-tools/.env NUNCA deve ser versionado.
# Não cole chave, senha ou passphrase em Issue, PR, log ou chat.
#
# Configuração de acesso SSH/SFTP usada pelos utilitários de vps-tools.

VPS_HOST=
VPS_USER=root
VPS_PORT=22

# Autenticação recomendada: chave privada em arquivo local protegido (0600).
VPS_SSH_KEY_PATH=
# Passphrase somente quando a chave for cifrada.
VPS_SSH_PASSPHRASE=

# Alternativa para cofres/CI que injetam o segredo diretamente no ambiente.
# Para uso local, prefira VPS_SSH_KEY_PATH.
VPS_SSH_KEY=

# Compatibilidade com hosts que ainda aceitem senha. A VPS de produção atual
# deve permanecer key-only; esta variável não é instrução para reabilitar senha.
VPS_PASSWORD=
