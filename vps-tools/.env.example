# vps-tools/.env.example
# Copie este arquivo para vps-tools/.env e preencha com os valores REAIS.
# O arquivo vps-tools/.env NUNCA deve ser versionado (já está no .gitignore).
#
# Credenciais de acesso SSH/SFTP à VPS usadas por run.js, upload.js, sync.js,
# pull-file.js e deploy-rebrand.js.

VPS_HOST=
VPS_USER=root
VPS_PASSWORD=
VPS_PORT=22
