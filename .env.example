APP_ENV=production
DEBUG=false

POSTGRES_USER=ejc_user
POSTGRES_PASSWORD=TROCAR_POR_SENHA_FORTE
POSTGRES_DB=ejc_db

SECRET_KEY=TROCAR_POR_CHAVE_ALEATORIA_LONGA
# Validade do access token JWT em HORAS (default 2). A sessão do usuário NÃO
# acaba em 2h: o frontend renova sozinho via POST /auth/refresh (rotação de
# refresh token, validade REFRESH_TOKEN_EXPIRE_DAYS=7). TTL curto = janela
# menor para token vazado/pós-revogação. Só aumente se um cliente de API
# externo (sem fluxo de refresh) precisar de tokens mais longos.
ACCESS_TOKEN_EXPIRE_HOURS=2
# 2FA (TOTP) obrigatório por PAPEL — enforcement SEM lockout: o login apenas
# sinaliza `precisa_configurar_2fa` e o /auth/totp/desativar recusa desproteger
# quem é obrigado. Default inclui gestão + advogados. Deixe vazio para 2FA
# 100% opt-in, ou ajuste a lista (CSV de papéis, case-insensitive).
REQUIRE_2FA_ROLES=superadmin,admin,socio,advogado,advogado_auxiliar
CORS_ORIGINS=https://seu-dominio.com.br,http://seu-ip
FRONTEND_URL=https://seu-dominio.com.br

# PII em repouso (LGPD) — OBRIGATÓRIAS em produção (o app NÃO as gera sozinho
# quando APP_ENV=production). Sem elas, cpf/cnpj cifrados quebram.
#   PII_ENCRYPTION_KEY: chave Fernet (32 bytes url-safe base64). Gere com:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PII_HASH_KEY: gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_ENCRYPTION_KEY=TROCAR_POR_CHAVE_FERNET
PII_HASH_KEY=TROCAR_POR_CHAVE_ALEATORIA

# Cofre de Credenciais (services/vault_crypto.py) — OBRIGATÓRIA em produção
# (o boot falha sem ela, config.py). CSV de chaves Fernet, a primeira é a
# primária (as demais só servem para rotação: descriptografam o que foi
# cifrado com uma chave antiga, sem reencriptar). NÃO reusar
# PII_ENCRYPTION_KEY/BACKUP_ENCRYPTION_KEY nem derivar de SECRET_KEY.
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_MASTER_KEYS=TROCAR_POR_CHAVE_FERNET

# Usuário admin inicial (criado pelo seeds/seed_all.py no 1º boot, idempotente).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e impressa UMA vez
# no log do container (docker compose logs backend). must_change_password=True.
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_NAME=Administrador EJC
ADMIN_PASSWORD=TROCAR_POR_SENHA_FORTE_INICIAL

AI_ENABLED=true
# Perfil de IA — UMA variável que deriva os *_ENABLED, AI_EXTERNAL_PROVIDERS_ALLOWED
# e AI_PROVIDER_PRIORITY (fonte única; código, este arquivo e o compose não
# divergem mais). Valores:
#   externo   → só nuvem (Anthropic/Groq; Maritaca se MARITACA_ENABLED=true), Ollama off
#   local     → só Ollama (soberania total: nada sai do VPS)
#   hibrido   → nuvem + Ollama como rede de segurança
#   desligado → AI_ENABLED=false (kill-switch)
#   (vazio)   → usa as flags manuais abaixo, como sempre foi
AI_PROFILE=
AI_PROVIDER=auto
# Groq (nuvem, tier grátis). Sem chave = Groq inelegível; a cadeia usa os demais.
# Desliga o Groq sem apagar a chave (mesma semantica de ANTHROPIC_ENABLED).
GROQ_ENABLED=true
GROQ_API_KEY=
# AI-043: llama-3.3-70b-versatile depreciado pela Groq (fim ago/2026) —
# substituto oficial recomendado abaixo (contexto 128k).
GROQ_MODEL=openai/gpt-oss-120b
# Modelo de contexto longo (fallback p/ dossiês grandes, prompt > 20k chars).
GROQ_MODEL_LARGE=openai/gpt-oss-120b
GROQ_TIMEOUT=60
# Transcrição de mídia (Groq Speech-to-Text): opt-in por privacidade. Mesmo
# ligada aqui, cada upload exige confirmação explícita na interface e o
# kill-switch AI_EXTERNAL_PROVIDERS_ALLOWED precisa permanecer true.
AUDIO_TRANSCRIPTION_ENABLED=false
AUDIO_TRANSCRIPTION_MAX_MB=25
AUDIO_TRANSCRIPTION_TIMEOUT=180
# Gates de governança: só true após (1) ativar/verificar Zero Data Retention nos
# Data Controls do Groq e (2) aprovar DPA + mecanismo de transferência
# internacional conforme a política do escritório/Resolução ANPD 19/2024.
GROQ_ZDR_VERIFIED=false
AUDIO_TRANSCRIPTION_DPA_APPROVED=false
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
# Leitura em blocos para documentos extensos — acima do teto a API falha de
# forma explícita e orienta indexação no Data Room (nunca trunca silenciosamente).
AI_LONG_DOCUMENT_MAX_CHARS=120000
AI_LONG_DOCUMENT_CHUNK_CHARS=16000
AI_LONG_DOCUMENT_MAX_CHUNKS=12
# Custo estimado Groq (R$ por 1M tokens) p/ auditoria de gasto. 0 = não estima.
GROQ_PRECO_INPUT_BRL_POR_MILHAO=0
GROQ_PRECO_OUTPUT_BRL_POR_MILHAO=0
# Chave da API Anthropic (Claude) — cole aqui o valor real (sk-ant-...).
# Sem ela o Claude fica indisponivel e a IA cai para Groq. NUNCA versionar.
ANTHROPIC_API_KEY=
# Modelos Claude (opcional). RAPIDO = Haiku (barato); COMPLEXO = Opus 4.8
# (maxima qualidade juridica, $5/$25 por 1M tokens — o prompt caching reduz
# leituras repetidas a ~10%). Para reduzir custo: claude-sonnet-5 ($3/$15).
ANTHROPIC_MODEL_RAPIDO=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_COMPLEXO=claude-opus-4-8
# Profundidade de raciocinio nos modelos modernos: low | medium | high
ANTHROPIC_EFFORT=high

# ── IA — Núcleo Único (policy central de provedores) ────────────────────────
# Liga/desliga o provider Anthropic sem remover a chave.
ANTHROPIC_ENABLED=true
# Timeout do client Anthropic em segundos.
ANTHROPIC_TIMEOUT_SECONDS=120
# Teto duro de tokens de saida por chamada (controle de custo).
# Nos modelos modernos (Opus 4.7+/Sonnet 5) o thinking adaptativo exige piso
# de 8192 — o teto efetivo nesses modelos e max(ANTHROPIC_MAX_TOKENS, 8192).
ANTHROPIC_MAX_TOKENS=8000
# Prompt caching Anthropic: bloco system com cache_control ephemeral (leituras
# repetidas do mesmo prefixo custam ~10%). true = comportamento padrao.
AI_PROMPT_CACHING_ENABLED=true
# Busca web (verificacao ativa) via server-side tool do Anthropic. Default OFF
# (padrao de integracoes do repo); com true, o tool web_search e anexado apenas
# a chamadas que JA passaram pela pseudonimizacao/sanitizacao do gateway.
AI_WEB_SEARCH_ENABLED=false
# Maximo de buscas por chamada (max_uses do tool web_search).
AI_WEB_SEARCH_MAX_USES=3
# Preco da busca web Anthropic, cobrado A PARTE dos tokens (tabela oficial:
# US$ 10 por 1.000 buscas). Somado ao custo estimado (AILog/governanca/budget).
AI_WEB_SEARCH_CUSTO_USD_POR_1000=10.0
# Governanca de custo: alerta no painel de Governanca da IA quando o gasto
# estimado de IA no periodo exceder este valor (R$). 0 = sem alerta (so exibe).
AI_BUDGET_ALERTA_BRL=0
# ── IA — Maritaca (Sabia) — provider BRASILEIRO, OpenAI-compatible ─────
# PLUGAVEL: nasce DESLIGADO (MARITACA_ENABLED=false) -> sistema identico ao
# atual. Provider EXTERNO ao VPS -> passa pela MESMA barreira LGPD
# (pseudonimizacao). Chave definida APENAS aqui/no ambiente (nunca no codigo).
# Soberania de dados NAO e o default nem automatica: exige DUAS coisas juntas —
# (1) MARITACA_MODEL/MARITACA_MODEL_RAPIDO nas variantes "-br-sp" (sabia-4-br-sp,
# sabiazinho-4-br-sp), que processam 100% em territorio nacional (+30%); e
# (2) MARITACA_EXIGIR_SOBERANIA=true. Os defaults abaixo NAO sao soberanos.
MARITACA_ENABLED=false
MARITACA_API_KEY=
MARITACA_BASE_URL=https://chat.maritaca.ai/api
MARITACA_MODEL=sabia-4
MARITACA_MODEL_RAPIDO=sabiazinho-4
MARITACA_TIMEOUT=90
# Guarda de soberania (opt-in, default OFF). true + MARITACA_ENABLED=true faz o
# BOOT EXIGIR que MARITACA_MODEL e MARITACA_MODEL_RAPIDO terminem em "-br-sp"
# (processamento em territorio nacional); caso contrario o boot FALHA.
MARITACA_EXIGIR_SOBERANIA=false
# false = so Ollama local; nenhum dado sai do VPS (Anthropic/Groq inelegiveis).
AI_EXTERNAL_PROVIDERS_ALLOWED=true
# true = sanitizacao LGPD obrigatoria antes de qualquer provider externo.
# NUNCA desligar em producao sem parecer do encarregado de dados.
AI_REQUIRE_SANITIZATION_FOR_EXTERNAL=true
# Excecao CONSCIENTE e AUDITAVEL: em producao, se algum provider externo for
# elegivel e AI_REQUIRE_SANITIZATION_FOR_EXTERNAL=false, o boot FALHA — a menos
# que esta flag seja true (parecer do encarregado de dados registrado).
AI_ACCEPT_EXTERNAL_WITHOUT_SANITIZATION=false
# Intake de documentos (importacao inteligente):
# true (default) = se o Ollama local estiver indisponivel, a interpretacao do
# documento pode usar provedor externo (Anthropic/Groq, EUA — transferencia
# internacional, art. 33 LGPD). O texto vai SANITIZADO (CPF/CNPJ/OAB/processo
# viram marcadores) e o dado pessoal exato e extraido LOCALMENTE por regex,
# nunca enviado. false = fail-closed: intake so com Ollama local; sem Ollama a
# importacao degrada com erro claro citando esta flag.
INTAKE_EXTERNAL_FALLBACK=true
# true = toda saida de IA e rascunho com revisao humana obrigatoria (OAB).
AI_REQUIRE_HITL=true
# Gate antialucinacao de citacoes: bloquear | marcar | desligado.
# bloquear = aprovacao HITL exige override justificado se houver citacao bloqueante.
# RUNBOOK DE EMERGENCIA: se a verificacao de citacoes quebrar em producao com
# politica=bloquear (aprovacoes HITL retornando 503 com stacktrace no log do
# backend), mude para CITACOES_POLITICA=marcar e REINICIE o backend — o valor
# e lido via get_settings(), que e cacheado; editar o .env sem reiniciar NAO
# tem efeito. Depois investigue o stacktrace e retorne para "bloquear".
CITACOES_POLITICA=bloquear
# Modo estrito do gate (opt-in, default off). true = sumula/artigo citado mas
# AUSENTE da base curada — ou achado APENAS em versao superada — passa a
# BLOQUEAR (nao so sinalizar). Barra invencao plausivel, nao so erro estrutural.
# Ligue SO com a base ja abrangente, senao gera falso-positivo em citacao real
# ainda nao ingerida. Meca antes de virar a chave:
#   docker exec -i ejc_backend python - < scripts/medir_impacto_modo_estrito.py
# Criterio e procedimento: docs/ai/DECISAO_CITACOES_MODO_ESTRITO.md
CITACOES_MODO_ESTRITO=false
# Piso do nivel de raciocinio quando o call site NAO pede nivel explicito.
# padrao | alto | maximo (ver ai_gateway.NIVEL_INTELIGENCIA_PROMPTS).
# Tarefa de MERITO juridico (analise, peca, estrategia) usa o primeiro; as
# demais tarefas de prosa usam o segundo. Tarefa de saida JSON (triagem,
# prazos, honorarios) e tarefa economica (resumo, chat) ficam em "padrao":
# instrucao de raciocinio em prosa disputaria com o formato exigido.
AI_NIVEL_INTELIGENCIA_MERITO=maximo
AI_NIVEL_INTELIGENCIA_PADRAO=alto
# Ordem de preferencia entre provedores elegiveis (csv). QUALIDADE PRIMEIRO:
# o modelo forte (Anthropic) atende antes; Maritaca (Sabia, legal-tuned PT-BR)
# antes do groq; a IA local (ollama) por ULTIMO, como rede de seguranca — e so
# entra na cadeia quando elegivel (ENABLED + chave, quando aplicavel).
# Inverta para "ollama,..." apenas se quiser IA local atendendo primeiro
# (soberania de dados) e houver um servico Ollama de pe.
AI_PROVIDER_PRIORITY=anthropic,maritaca,groq,ollama
# Niveis de sanitizacao de PII por tipo de tarefa (LGPD art. 33/46).
# JSON OPCIONAL task_type->modo que SOBREPOE o default (revisavel por Dr. Clovis)
# em app/services/ai/sanitization_policy.py. Modos:
#   local_completo         = so Ollama local; conteudo NUNCA vai a externo.
#   externo_pseudonimizado = pseudonimiza reversivel -> externo -> reidrata.
#   extracao_local         = extracao estruturada local (importacao/OCR).
#   mascaramento           = mascaramento irreversivel (legado/fallback).
# Vazio = usa o default. Fail-safe: JSON invalido/modo desconhecido -> default.
# Ex.: AI_SANITIZATION_MODE_MAP={"familia":"local_completo","triagem":"mascaramento"}
AI_SANITIZATION_MODE_MAP=

# ── Fase 6 — Roteamento inteligente por complexidade/custo ──────────────────
# OFF por padrão = comportamento atual por task_type intacto. Quando ON, o
# model_router (heurística DETERMINÍSTICA, sem IA) propõe o provedor de PARTIDA
# da cadeia por complexidade do input. O gateway AINDA aplica elegibilidade/
# kill-switch/barreira PII e o fallback — o roteador só PROPÕE.
ROTEAMENTO_INTELIGENTE_ENABLED=true
ROTEAMENTO_PROVIDER_LEVE=groq
# medio = anthropic (Haiku): o stack de producao nao sobe ollama.
ROTEAMENTO_PROVIDER_MEDIO=anthropic
ROTEAMENTO_PROVIDER_PESADO=anthropic
# Validacao adversarial (2a IA critica) nas pecas de alta complexidade.
# A critica NUNCA bloqueia a entrega: se falhar, anexa aviso e o HITL segue.
DUAS_IAS_ENABLED=true

# ── Sala Jurídica ────────────────────────────────────────────────────────────
# Extração automática do estado jurídico consolidado após cada resposta.
SALA_JURIDICA_AUTO_ESTADO=true
# CSV de task_types que disparam a critica automatica.
DUAS_IAS_TASK_TYPES=elaboracao_peca,auditoria_peca

# Exportação de DEMONSTRATIVO DE CÁLCULO como peça (POST /api/pecas/demonstrativo).
# Default FALSE (403) por decisão da auditoria de 2026-07-26: um demonstrativo dá
# aparência DOCUMENTAL a uma regra de calculadora ainda não homologada
# (fonte/vigência/revisor) e pode circular fora do escritório. Existe também um
# gate POR FERRAMENTA (matriz FERRAMENTAS_NAO_HOMOLOGADAS), que responde 422 com o
# motivo específico e roda ANTES desta trava — mas ele é uma denylist: cobre as
# ferramentas já auditadas como não homologadas, não as que ninguém revisou.
# Só mude para true depois de homologar as regras das calculadoras em uso.
PECAS_DEMONSTRATIVO_CALCULADORA_ENABLED=false
ROTEAMENTO_LIMIAR_MEDIO=3
ROTEAMENTO_LIMIAR_PESADO=6

# ── Módulo agêntico de IA (loop de tool-use, igual ao Claude Code) ──────────
# ATIVADO por default (decisao do titular): a IA opera como agente (decide ->
# chama ferramenta -> le resultado -> decide), reusando o nucleo e TODOS os
# guardrails (barreira LGPD, RBAC, AILog, gate de citacoes, HITL nas escritas).
# Nesta fase so provedores com tool-use (Anthropic).
# DESLIGADO no template (auditoria 2026-07-26, AI-033/AI-034): o deploy copia
# este arquivo para .env, e o valor daqui SOBREPOE o default do config.py — sem
# esta linha em false, todo deploy novo subiria com write-tools ligadas. Ligar
# so por decisao explicita, apos homologacao do HITL.
AI_AGENT_ENABLED=false
# Teto de PASSOS do loop (nunca infinito).
AI_AGENT_MAX_STEPS=8
# Teto de TOKENS acumulados por execucao do agente (controle de custo).
# Alinhado ao default do codigo — 16000 matava o agente no passo 2-3 (achado M3).
AI_AGENT_MAX_TOKENS=120000

# ── Fase 6 — Observabilidade de IA (Langfuse SELF-HOSTED) ───────────────────
# Langfuse é SELF-HOSTED (docker-compose --profile observability). Dados
# jurídicos NÃO saem do ambiente — NUNCA apontar para cloud.langfuse.com.
# OFF por padrão: wrapper NO-OP total (não importa SDK, não conecta) e o fluxo
# de IA nunca quebra por causa do tracing.
# Primeira subida: `docker compose --profile observability up -d langfuse` e
# criar projeto/chaves na UI (http://SEU_HOST:3000). Cole as chaves abaixo.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LGPD: por padrão SÓ metadados (task_type, provider, modelo, tokens, latência,
# custo, sucesso/erro) vão ao Langfuse — NUNCA prompt/resposta crus. Ligar True
# envia conteúdo APÓS a MESMA sanitização PII do gateway. Não ligar sem DPO.
LANGFUSE_CAPTURE_CONTENT=false
# Segredos do Langfuse self-hosted (só usados pelo serviço no compose):
LANGFUSE_DB_PASSWORD=troque_esta_senha
LANGFUSE_NEXTAUTH_SECRET=troque_gere_com_openssl_rand_base64_32
LANGFUSE_SALT=troque_gere_com_openssl_rand_base64_32
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# ── Ollama — modelos locais (soberania total, sem custo por token) ──────────
# Ligado por padrão: se não houver serviço Ollama acessível em
# OLLAMA_BASE_URL, a cadeia de fallback do ai_gateway (chat()/_resolver_cadeia)
# detecta a falha rapidamente (conexão recusada/DNS) e segue para o próximo
# provedor elegível (Anthropic/Groq) sem quebrar a requisição do usuário.
# Para provisionar o container local: docker compose --profile ia-local up -d
# (ou scripts/subir-ia-local.sh). Com o profile DESLIGADO nada muda no `up`
# padrão — a cadeia segue caindo para Anthropic/Groq automaticamente.
# Default FALSE: o stack padrao NAO sobe o Ollama (profile opt-in "ia-local").
# Ligue apenas se houver um servico Ollama de pe — e note que a IA local nao
# tem relacao com as chaves de Anthropic/Maritaca/Groq: ela existe para o caso
# em que o conteudo NAO pode sair do VPS (PII residual barra provedor externo).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434

# Modelos que o serviço one-shot `ollama-init` baixa (CSV). FONTE ÚNICA da
# lista de pulls — mantenha em sincronia com os OLLAMA_MODEL_* abaixo.
OLLAMA_PULL_MODELS=deepseek-r1:8b,qwen2.5:14b,gemma3:9b
# Teto de RAM do container ollama (mem_limit) e tempo que o modelo fica
# carregado após ociosidade antes de liberar a RAM.
OLLAMA_MEM_LIMIT=12g
OLLAMA_KEEP_ALIVE=10m

# ── Perfis de hardware prontos (descomente UM bloco e ajuste) ────────────────
# RAM aproximada por modelo em CPU (sem GPU): llama3.2:3b/qwen2.5:3b ≈ 3-4GB;
# deepseek-r1:8b/gemma3:9b ≈ 6-7GB; qwen2.5:14b ≈ 10-11GB. O compose limita o
# container a OLLAMA_MEM_LIMIT e carrega 1 modelo por vez. Se o Ollama estiver
# indisponível ou estourar o timeout, a cadeia do ai_gateway cai para
# Anthropic/Groq automaticamente — nada quebra; só deixa de ser custo zero.
#
# (a) VPS modesta — 8 GB de RAM total (deixa ~4 GB para app+banco):
# OLLAMA_PULL_MODELS=llama3.2:3b
# OLLAMA_MEM_LIMIT=5g
# OLLAMA_MODEL_ANALISE=llama3.2:3b
# OLLAMA_MODEL_PETICAO=llama3.2:3b
# OLLAMA_MODEL_RESUMO=llama3.2:3b
# OLLAMA_MODEL_CHAT=llama3.2:3b
# OLLAMA_MODEL_CONTRATO=llama3.2:3b
#
# (b) Servidor 16 GB+ — modelos padrão do config.py (nada a sobrescrever):
# OLLAMA_PULL_MODELS=deepseek-r1:8b,qwen2.5:14b,gemma3:9b
# OLLAMA_MEM_LIMIT=12g
# OLLAMA_MODEL_ANALISE=deepseek-r1:8b   # análise jurídica profunda
# OLLAMA_MODEL_PETICAO=qwen2.5:14b      # elaboração de peças
# OLLAMA_MODEL_RESUMO=gemma3:9b         # resumos rápidos
# OLLAMA_MODEL_CHAT=gemma3:9b           # chat e perguntas simples
# OLLAMA_MODEL_CONTRATO=deepseek-r1:8b  # análise contratual

# ── DataJud/CNJ — API Pública (consulta de andamentos processuais) ───────────
# Integração externa é OPT-IN: desligada por padrão.
DATAJUD_ENABLED=false
# Chave PÚBLICA de uso geral divulgada pelo CNJ na wiki oficial:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/ (header "Authorization: APIKey <chave>").
# Nunca commitar a chave; ela não aparece em logs nem em mensagens de erro.
DATAJUD_API_KEY=
# Host oficial da API Pública (POST /{alias_tribunal}/_search). Só mude para testes.
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
DATAJUD_TIMEOUT_SECONDS=25
# Cache TTL (segundos) da consulta processual por número CNJ — em memória
# (worker único). 0 desliga. Erro do CNJ nunca entra no cache.
DATAJUD_CACHE_TTL_SEGUNDOS=900
# Limitador de requisições ao DataJud (req/s), usado pelo módulo de
# saneamento (backend/app/services/saneamento) ao varrer lotes de processos.
# A VERIFICAR: nenhuma fonte oficial do CNJ declara rate limit da API
# Pública — valor conservador até confirmação.
DATAJUD_RATE_LIMIT_RPS=5.0
# Nota: os endpoints /api/integracoes/datajud/* (app/integrations/) usam esta
# mesma DATAJUD_API_KEY e respeitam DATAJUD_ENABLED (Onda 3): a chave pública
# do CNJ que ficava embutida em app/integrations/datajud_client.py foi
# REMOVIDA — sem flag+chave, esses endpoints respondem 503.

# ── PNCP — REMOVIDO (2026-07) ────────────────────────────────────────────────
# A integração de consulta ao PNCP (licitações) foi removida do EJC junto com
# o módulo de licitações. Variáveis PNCP_* em .env existentes são ignoradas.

# ── Conecta gov.br — APIs governamentais (CPF, CNPJ, CND, DOU…) — INATIVO ────
# Exige credenciamento institucional prévio no Conecta gov.br (Serpro) e
# emissão de client_id/client_secret por API contratada (OAuth2
# client_credentials). AGUARDANDO CREDENCIAMENTO: o cliente foi removido do
# código até o cadastro oficial existir; deixe vazio — nenhum router Conecta é
# registrado no main.py. NUNCA preencher com valores inventados.
CONECTA_CLIENT_ID=
CONECTA_CLIENT_SECRET=

# ── Infosimples — consultas PAGAS a sites públicos (TJMG, Receita Federal…) ──
# Agregador comercial (https://infosimples.com/consultas/): CADA CONSULTA
# EXECUTADA É COBRADA. Opt-in: desligado por padrão — ligue só após contratar.
# INFOSIMPLES_ENABLED=false
# Token da conta contratada (painel da Infosimples). Vai só no corpo da
# requisição; nunca aparece em logs, erros ou respostas do EJC.
# INFOSIMPLES_TOKEN=
# Timeout repassado à Infosimples (segundos) — consultas raspam sites públicos
# e podem demorar; o cliente HTTP do EJC usa este valor + 30s de margem.
# INFOSIMPLES_TIMEOUT=300
# TETO DE CUSTO: máx. de consultas cobradas por dia (UTC). Atingido o teto,
# novas consultas retornam 429 até o dia virar. Cache: a MESMA consulta
# repetida no mesmo dia devolve o resultado salvo SEM nova cobrança.
# INFOSIMPLES_MAX_CONSULTAS_DIA=50
# Base da API (POST {base}/{caminho}, form-urlencoded). Só mude para testes.
# INFOSIMPLES_BASE_URL=https://api.infosimples.com/api/v2/consultas

# ── NFS-e — emissão fiscal via provedor (Nuvem Fiscal) — GATED ───────────────
# NASCE DESLIGADO e em HOMOLOGAÇÃO: nunca emite nota real sem ativação explícita.
# A emissão REAL exige, FORA do EJC: (1) certificado digital A1 (e-CNPJ ICP-Brasil)
# enviado ao painel do provedor; (2) confirmar com o CONTADOR a alíquota de ISS
# de advocacia em Betim, o item LC116 (17.14) e o cTribNac. Ver docs/NFSE_VIABILIDADE.md.
# Fluxo: homologação → conferir 1 nota de teste com o contador → produção.
# NFSE_ENABLED=false
# NFSE_MODO=homologacao            # homologacao | producao
# NFSE_PROVEDOR=nuvemfiscal
# NFSE_NUVEMFISCAL_BASE_URL=https://api.nuvemfiscal.com.br
# NFSE_NUVEMFISCAL_AUTH_URL=https://auth.nuvemfiscal.com.br
# Credenciais OAuth2 (painel Nuvem Fiscal) — nunca aparecem em log/erro/resposta.
# NFSE_NUVEMFISCAL_CLIENT_ID=
# NFSE_NUVEMFISCAL_CLIENT_SECRET=
# CNPJ do escritório emitente (com ou sem máscara).
# NFSE_EMITENTE_CNPJ=
# Município do emitente (código IBGE 7 díg). Betim/MG = 3106200.
# NFSE_EMITENTE_MUN_IBGE=3106200
# Definições fiscais — CONFIRMAR COM O CONTADOR antes de produção:
# NFSE_ISS_ALIQUOTA=            # alíquota ISS advocacia em Betim (%). A confirmar.
# NFSE_ITEM_LC116=17.14        # item da lista LC 116/03 (advocacia)
# NFSE_CTRIB_NAC=              # cTribNac (GET /nfse/cidades/3106200). A confirmar.
# NFSE_TIMEOUT=60

# ── TJMG — coletor de jurisprudência estadual MG → RAG (crawler agendado) ────
# O TJMG não tem API aberta: a coleta depende de scraping do formulário HTML.
# LIGADO por decisão do titular. O scraper é frágil — ACOMPANHE o painel
# /ia-governanca/fontes (novos/total/erro da fonte "tjmg"); se marcar 'erro', o
# LexML federado abaixo já cobre o TJMG. Desligue com TJMG_INGEST_ENABLED=false.
# Job semanal (sáb 04h30), gated por ENABLE_SCHEDULER + TJMG_INGEST_ENABLED.
TJMG_INGEST_ENABLED=true
# Temas de busca (CSV). VAZIO = lista padrão CURADA no código (tjmg.TEMAS_PADRAO)
# — já cobre cível, consumidor, imobiliário, família, trabalhista, tributário,
# administrativo, penal, previdenciário, empresarial e ambiental (~27 temas).
# Só preencha para RESTRINGIR/DIRECIONAR a coleta. Recomendado p/ volume amplo:
# deixe VAZIO (usa a lista completa). Exemplo de subconjunto direcionado:
# TJMG_INGEST_TEMAS=dano moral,plano de saúde negativa de cobertura,revisional contrato bancário juros,usucapião,guarda e alimentos,execução fiscal prescrição,recuperação judicial e falência,benefício previdenciário aposentadoria
TJMG_INGEST_TEMAS=
# Janela (dias p/ trás) do filtro de data de julgamento. 0 = sem filtro.
# Para uma carga inicial de VOLUME, considere subir para 365 (1 ano) na 1ª
# execução e voltar a 30 depois (as execuções seguintes só trazem o novo).
TJMG_INGEST_JANELA_DIAS=30
# Teto de acórdãos por tema/execução (controle de volume e de carga no portal).
# Volume amplo: até ~200 (respeite o portal — a coleta é sequencial e educada).
TJMG_INGEST_MAX_POR_TEMA=50

# ── LexML — FEDERADOR oficial (legislação + jurisprudência) → RAG ────────────
# O LexML.gov.br (Senado) federa, numa fonte pública só, legislação FEDERAL/
# ESTADUAL (ALMG)/MUNICIPAL (Betim) e jurisprudência de TJ/TRT/TRF/TST/STJ/STF.
# É o jeito de ampliar o VOLUME estadual/municipal/tribunais SEM escrever um
# scraper dedicado por portal. Usa o caminho provado buscar_lexml (keyword-based)
# para tipo='legislacao' E 'jurisprudencia', por um catálogo de temas/autoridades
# do escritório (Betim/MG). Job semanal (sáb 05h), gated por ENABLE_SCHEDULER +
# LEXML_INGEST_ENABLED. LIGADO por decisão do titular (fonte pública gratuita).
# ACOMPANHE novos/total/erro da fonte "lexml" em /ia-governanca/fontes após o
# 1º deploy (as URLs .gov não puderam ser validadas ao vivo no dev).
LEXML_INGEST_ENABLED=true
# Temas de busca (CSV). VAZIO = lista padrão CURADA no código (lexml.TEMAS_PADRAO)
# — já mira TJMG/TRT-3/TRF-6/TRF-1/TST/STJ/STF/JEC, ALMG (leis estaduais MG),
# Betim (leis municipais) e as áreas nucleares do escritório (~24 temas). Só
# preencha para RESTRINGIR/DIRECIONAR. Exemplo de subconjunto direcionado:
# LEXML_INGEST_TEMAS=TRT-3 horas extras,TRF-6 previdenciário,ALMG lei estadual Minas Gerais,Betim lei municipal
LEXML_INGEST_TEMAS=
# Teto de itens por tema/tipo/execução (a busca cobre 2 tipos por tema).
LEXML_INGEST_MAX_POR_TEMA=20

# ── DJEN / API Comunica CNJ — intimações/publicações por OAB → RAG ──────────
# Ingestor DIÁRIO de comunicações processuais (Res. CNJ 569/2024). A retenção
# da API é limitada — o RAG vira o arquivo histórico permanente. LIGADO por
# decisão do titular (fonte pública CNJ, sem autenticação).
DJEN_INGEST_ENABLED=true
# CSV "numero/UF" das OABs monitoradas — ex.: "12345/MG,67890/MG". Vazio = no-op.
# Default = OABs dos sócios Guilherme Alves de Paula (OAB/MG 252.599) e
# João Pedro Teixeira Rodrigues (OAB/MG 251.174). Só as comunicações de
# processos com caso ATIVO cadastrado entram no RAG (filtro anti-PII no
# ingestor). Acrescente outras OABs por vírgula, sem pontuação no número.
DJEN_OABS_MONITORADAS=252599/MG,251174/MG
# Janela incremental (dias p/ trás) de cada coleta (sobreposição é inofensiva).
# Deixe 2 no regime diário. Para um backfill inicial, suba pontualmente (ex.: 30)
# na 1ª execução e volte a 2 — o dedup por chave_origem evita duplicatas.
DJEN_INGEST_JANELA_DIAS=2
# Captura por advogado também ingere a intimação vinculada ao caso no RAG
# (categoria comunicacao_processual, sempre com rag_status=pendente — a
# curadoria continua humana). Antes só o ingestor por OAB monitorada fazia isso.
DJEN_CAPTURA_INGERIR_RAG=true

# ── Conhecimento oficial (ANPD + Normas RFB) → RAG — Bloco 3 ────────────────
# Job SEMANAL (domingo 03h00 UTC): raspa as páginas gov.br da ANPD
# (regulamentações e guias orientativos — LGPD, teto 30 docs/execução) e a
# busca do sijut2consulta da RFB (atos tributários, teto 20 docs/execução,
# pausa educada de 1s). Idempotente por chave_origem (anpd:<slug> /
# rfb:<tipo>:<numero>:<ano>) — reexecutar não duplica. Ligado por padrão
# (fontes públicas, sem custo). Disparo manual: POST /rag/ingest-fontes-oficiais.
CONHECIMENTO_INGEST_ENABLED=true
# CSV de termos da busca RFB. Vazio = lista padrão do ramo tributário
# (Solução de Consulta ISS, IRPF, Simples Nacional, PIS COFINS).
NORMAS_RFB_TERMOS=

# ── Importador de jurisprudência (página Conhecimento) ──────────────────────
# Fontes OFICIAIS habilitadas (CSV): lexml (LexML/Senado) e stj (Dados Abertos).
# Ligadas por padrão — APIs públicas, sem chave. Vazio = importador desabilitado
# (endpoint responde 422 com mensagem clara; nada quebra). Inclua `tjmg` aqui
# (JURIS_IMPORT_FONTES=lexml,stj,tjmg) para habilitar TAMBÉM o TJMG na busca
# on-demand da página Conhecimento — independente do job agendado abaixo.
JURIS_IMPORT_FONTES=lexml,stj

# ══════════════════════════════════════════════════════════════════════════
# COMO LIGAR VOLUME REAL DA BASE JURÍDICA EM PRODUÇÃO (mapa dos ingestores)
# ══════════════════════════════════════════════════════════════════════════
# Todo TEXTO vem das fontes OFICIAIS baixadas em runtime — o EJC só guarda
# REFERÊNCIAS (URLs/slugs) e configuração. Nada é fabricado. Todos os jobs são
# best-effort: falha de rede de uma fonte NUNCA derruba o boot/scheduler, só
# marca a fonte 'erro'/'parcial' no painel /ia-governanca/fontes.
#
# JÁ LIGADO POR PADRÃO (fontes públicas gratuitas, sem chave — nenhuma ação):
#   • Planalto (legislação federal) — job SEMANAL dom 03h (id="ing_planalto").
#     Catálogo ampliado em ingestors/planalto.py:CATALOGO (~30 diplomas core).
#   • STJ Dados Abertos (jurisprudência superior) — SEMANAL sáb 03h ("ing_stj"),
#     10 órgãos julgadores (Corte Especial + 3 Seções + 6 Turmas).
#   • Câmara/Senado (monitor legislativo) — DIÁRIO 04h00/04h20.
#   • Conhecimento oficial (ANPD + Normas RFB) — CONHECIMENTO_INGEST_ENABLED=true.
#   • Importador on-demand LexML+STJ (página Conhecimento) — JURIS_IMPORT_FONTES.
#   Pré-requisito comum: ENABLE_SCHEDULER=true no worker que roda os jobs.
#
# OPT-IN (integração externa nasce OFF — ligue só após validar contra a fonte
# real; a VPS alcança os hosts, dev/CI podem não alcançar). Para trazer VOLUME:
#   1) LEXML_INGEST_ENABLED=true       (FEDERAÇÃO estadual+municipal+tribunais,
#                                       sáb 05h; temas em lexml.TEMAS_PADRAO —
#                                       é o maior ganho de volume numa fonte só)
#   2) TJMG_INGEST_ENABLED=true        (jurisprudência estadual MG, sáb 04h30;
#                                       temas curados em tjmg.TEMAS_PADRAO)
#   3) DJEN_INGEST_ENABLED=true + DJEN_OABS_MONITORADAS=<oabs/UF do escritório>
#                                      (comunicações processuais → arquivo RAG)
#   4) (opcional) JURIS_IMPORT_FONTES=lexml,stj,tjmg  para o TJMG on-demand
#
# ALMG (leis estaduais MG) e BETIM (leis municipais): são cobertos HOJE pela
# FEDERAÇÃO LexML acima (item 1) — via PALAVRAS de localidade nos temas ("ALMG
# lei estadual Minas Gerais", "Betim lei municipal"), pois o LexML federa
# legislação estadual/municipal. Um ingestor DEDICADO aos portais próprios da
# ALMG (al.mg.leg.br) e da Câmara/Prefeitura de Betim ficaria com cobertura mais
# completa e estruturada, mas é um TODO que EXIGE BUILD VERIFICÁVEL com acesso
# .gov liberado (portais heterogêneos, sem caminho de consulta provado): não se
# escreve scraper cego. O mesmo vale para TRT-3/TRF-6/TRF-1 DIRETOS — por ora,
# federados via LexML; conectores diretos são follow-up com .gov acessível.
#
# AVISO DE CUSTO/REDE: são fontes GRATUITAS (sem API paga), mas geram tráfego de
# saída e carga nos portais — a coleta é sequencial/educada e limitada por teto
# (LEXML_INGEST_MAX_POR_TEMA, TJMG_INGEST_MAX_POR_TEMA, DJEN MAX_PAGINAS, STJ
# MAX_POR_ORGAO). O custo de IA só ocorre no re-embedding local dos novos chunks
# (sem provedor externo). Ligue uma fonte de cada vez e acompanhe novos/total/
# erro em /ia-governanca/fontes.

# ── Busca semântica do RAG (embeddings locais, sem serviço http) ─────────────
# Ligado por padrão: EMBEDDINGS_PROVIDER=local usa fastembed (dependência
# pinada no requirements.txt), sem serviço externo. O modelo
# (intfloat/multilingual-e5-large, 1024d via fastembed/ONNX) é
# baixado na PRIMEIRA chamada de embedding — não trava o boot.
# Desligado ou em erro, o RAG cai para busca textual (fallback gracioso —
# gerar_embeddings() nunca levanta exceção, ver embedding_service.py).
# EMBEDDINGS_PROVIDER=http (+ EMBEDDINGS_API_URL) só se existir container
# dedicado de embeddings — NÃO é necessário para o modo local.
EMBEDDINGS_ENABLED=true
EMBEDDINGS_PROVIDER=local
EMBEDDINGS_MODEL=intfloat/multilingual-e5-large
EMBEDDINGS_DIM=1024
# Textos por chamada de encode. NÃO é ajuste de desempenho — é contenção de
# memória. Sem teto explícito, o fastembed usa o default 256 e o arena
# allocator do ONNX cresce com o maior lote já visto sem devolver a memória:
# em 27/08/2026 a reindexação chegou a 10 GB de anon-rss e o OOM-killer global
# derrubou containers de outros sistemas na mesma VPS. Subir este número volta
# a ampliar o pico — meça antes.
EMBEDDINGS_BATCH=16
# Desligado por padrão: o único reranker multilíngue suportado nesta versão tem
# licença não comercial; ative somente após seleção licenciada + eval pt-BR.
RAG_RERANK_ENABLED=false
RAG_RERANK_MODEL=BAAI/bge-reranker-base
# Ligados por padrao (decisao do titular, 18/08 — nivel de inteligencia
# altissimo): ambos sao ADITIVOS a fusao RRF, fail-safe (erro cai para o
# comportamento anterior) e nao pioram recall, so somam. HyDE custa 1 chamada
# extra barata por busca RAG.
RAG_HYDE_ENABLED=true
RAG_FTS_ENABLED=true
# Só para EMBEDDINGS_PROVIDER=http (container dedicado — NÃO é o caso padrão):
# EMBEDDINGS_API_URL=http://embeddings:8010/embed
# EMBEDDINGS_TIMEOUT=120

# ── Governança/quarentena na recuperação RAG (auditoria RAG) ────────────────
# Gate fail-closed aplicado a TODA busca: docs com confidence_level='bloqueado'
# ou rag_status em (bloqueado/recusado/reprovado/pendente) nunca entram no
# prompt. RAG_EXIGIR_APROVADO=true torna o regime ESTRITO (só rag_status=
# 'aprovado' é recuperável). O acervo legado sem curadoria permanece em
# quarentena até reconciliação explícita.
RAG_EXIGIR_APROVADO=true
# Quarentena das súmulas: rede de segurança mesmo após a reconstrução do seed
# (27 verbetes reconferidos individualmente contra STF/STJ/TST). Só deixa
# passar doc de súmula marcado extra.conferido=true — protege contra
# reintrodução de conteúdo não conferido por outra via.
RAG_SUMULAS_QUARENTENA=true
# Situação JURÍDICA na recuperação (Issue #636). Curadoria (rag_status) e
# vigência da norma são coisas diferentes: um documento pode estar aprovado para
# o RAG e, ainda assim, estar revogado. O que está marcado como REVOGADO é
# excluído SEMPRE (não há flag para isso). Esta flag governa o caso duvidoso:
# com true (padrão), legislação cuja vigência a fonte não declarou
# ('vigencia_nao_verificada' na governança) também fica fora da recuperação.
# O filtro só alcança categorias de legislação — súmulas, jurisprudência,
# doutrina, modelos e peças internas continuam recuperáveis. Versões HISTÓRICAS
# (vigente=false) também seguem recuperáveis: a governança as classifica como
# 'historica', e é delas que sai o aviso "possivelmente desatualizada".
# ATENÇÃO OPERACIONAL: enquanto os ingestores não tiverem regravado
# `extra.legal_status` no acervo já existente (job semanal `ing_planalto` ou
# `python scripts/seed_legislacao.py` no container), a legislação legada some da
# recuperação e do gate de citação de artigo. Rode a reingestão junto do deploy;
# use false apenas como medida temporária.
# EXCEÇÃO PERMANENTE (não é transitória, a reingestão não resolve): a categoria
# `proposicao_legislativa` (ingestores da Câmara e do Senado) cai no mesmo
# recorte e NÃO grava vigência — logo fica fora da recuperação enquanto esta
# flag estiver ligada. É intencional: proposição é projeto em tramitação e não
# pode fundamentar peça como se fosse lei em vigor.
RAG_EXIGIR_VIGENCIA_VERIFICADA=true
# Ingestão do seed de súmulas (POST /sumulas/ingerir-seed) — reconstruído na
# auditoria RAG com verbetes reconferidos individualmente (situação
# ativa/cancelada/suspensa sinalizada; só ativa entra no RAG buscável).
# Padrão true. Desligue (false) só para suspender a ingestão rapidamente sem
# reverter código (o endpoint responde 423 quando false).
RAG_SUMULAS_SEED_ENABLED=true

# Seed da Base de Conhecimento (idempotente): POST /api/rag/seed (sócio+) ou
# `python scripts/seed_conhecimento.py` no container. Popula README de uso,
# checklists, padrão-ouro e modelos de estrutura de peça. Jurisprudência REAL
# entra pelo importador oficial (?incluir_jurisprudencia=true agenda os temas comuns).

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

WHATSAPP_ENABLED=false

# WhatsApp via Evolution API self-hosted — opcional (vendor Z-API removido).
# Sem os valores, os endpoints /whatsapp degradam com erro claro (não 500).
EVOLUTION_API_URL=http://evolution_api:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=ejc-escritorio
# Segredo do webhook de entrada (/webhooks/evolution). Sem ele o webhook
# responde 503 "não configurado" — nunca aceita chamada sem autenticação.
EVOLUTION_WEBHOOK_SECRET=

PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@depaulateixeira.adv.br

ENABLE_SCHEDULER=true
MAX_UPLOAD_MB=50

# ── Central Eletrônica de Diagnóstico (GET /diagnostico/central — SOCIO+) ─────
# Agrega a saúde de todos os subsistemas (banco, migrations, IA, integrações,
# RAG, scheduler, disco). Somente leitura; sem integração externa nova.
DIAGNOSTICO_ENABLED=true

# ── Automações voltadas ao cliente/dono (jobs opt-in — default false) ────────
# Sync diário DataJud + notificação de andamentos novos (exige DATAJUD_ENABLED
# + DATAJUD_API_KEY; desligado, o job é pulado em silêncio).
DATAJUD_SYNC_ENABLED=false
DATAJUD_SYNC_HORA_UTC=09:30
# Relatório semanal do dono (segunda-feira, e-mail aos sócios — exige EMAIL_ENABLED).
RELATORIO_DONO_ENABLED=false
# Régua de cobrança de honorários ao CLIENTE (d-3/d+1/d+7/d+15 + escalada).
COBRANCA_ENABLED=false

# ── Infra assíncrona e observabilidade (opt-in — defaults seguros) ───────────
# Fila Celery p/ indexação (docker-compose com serviço `worker`). false =
# BackgroundTasks no processo da API (comportamento padrão). Redis fora do ar
# → fallback gracioso para BackgroundTasks.
CELERY_ENABLED=false
REDIS_URL=redis://redis:6379/0
# Cache de resposta de IA (mesma requisição repetida em janela curta). Requer
# Redis; indisponível → segue sem cache.
AI_RESPONSE_CACHE_ENABLED=false
AI_RESPONSE_CACHE_TTL=300
# Rate limit distribuído via Redis — necessário só com uvicorn --workers > 1.
RATE_LIMIT_REDIS_ENABLED=false
# Proxy reverso: de quais IPs de origem o uvicorn aceita X-Forwarded-*.
# Vazio/ausente → o entrypoint usa "*". Sem isso o uvicorn confia só em
# 127.0.0.1, DESCARTA o X-Forwarded-Proto: https do Nginx (a origem, pelo
# Docker, é o gateway da bridge) e passa a emitir redirect para http:// — que o
# browser bloqueia numa página https ("Failed to fetch").
#
# ATENÇÃO ao apertar: esta versão do uvicorn compara o IP por STRING EXATA
# (`client_host in trusted_hosts`) e NÃO entende CIDR. Escrever
# "172.18.0.0/16" não dá erro — passa a não confiar em ninguém, o
# X-Forwarded-Proto volta a ser descartado e o bug do redirect reaparece em
# produção sem sintoma no boot. Use IPs exatos separados por vírgula
# (ex.: "172.18.0.1,127.0.0.1"). O boot avisa se encontrar "/" no valor.
FORWARDED_ALLOW_IPS=
# Logs em JSON (agregadores) e nível raiz.
LOG_JSON=false
LOG_LEVEL=INFO
# Sentry (rastreamento de erros). Vazio = desabilitado.
SENTRY_DSN=

# Salário mínimo nacional vigente (calculadoras) — atualizar pelo decreto anual.
SALARIO_MINIMO_BRL=1518.00

# Backup automático (scheduler.py, job das 02h00: pg_dump do banco em BACKUP_DIR).
# BACKUP_REMOTE = destino OFFSITE do backup via rclone (ex.: um remote já
# configurado com `rclone config`, como "gdrive:ejc-backups" ou "s3:bucket/ejc").
# Vazio (default) = backup só local no volume; nenhum upload offsite é feito.
# Requer o binário `rclone` disponível no ambiente e o remote configurado.
BACKUP_REMOTE=

# ── Google Drive → Base de Conhecimento (leitura) — opcional ─────────────────
# Sincroniza uma pasta do Drive com o RAG (/api/rag/google-drive/*). Desligado
# (default) os endpoints respondem 503 com mensagem clara — nada quebra.
GOOGLE_DRIVE_ENABLED=false
# ID da pasta de conhecimento (trecho após /folders/ na URL do Drive).
GOOGLE_DRIVE_KNOWLEDGE_FOLDER_ID=
# Shared Drive (opcional, só se a pasta estiver em Drive compartilhado).
GOOGLE_DRIVE_SHARED_DRIVE_ID=
# Autenticação: auto | oauth_user | service_account. Preencha UM dos modos:
GOOGLE_DRIVE_AUTH_MODE=auto
#  (a) OAuth de usuário — client + refresh token (ou arquivo/JSON com o token):
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# GOOGLE_DRIVE_OAUTH_USER_FILE=/app/secrets/gdrive_oauth_user.json
# GOOGLE_DRIVE_OAUTH_USER_JSON=
#  (b) Service Account — arquivo OU JSON inline (compartilhe a pasta com o SA):
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=/app/secrets/gdrive_sa.json
# GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Curadoria automática de categoria na ingestão (true) e limites de arquivo:
GOOGLE_DRIVE_AUTO_CATEGORIZAR=true
GOOGLE_DRIVE_DEFAULT_CATEGORIA=auto
GOOGLE_DRIVE_MAX_FILE_MB=50
# CSV de MIME types aceitos. Vazio = defaults do serviço (PDF/texto/docs Google).
GOOGLE_DRIVE_ALLOWED_MIME_TYPES=

# ── Backup diário cifrado → Google Drive (services/backup_service.py) ────────
# Prefere credencial EXCLUSIVA de escrita para não ampliar o escopo do RAG.
# Em produção, use service_account e compartilhe a pasta de backup como Editor.
# `auto` tenta credencial dedicada e só então herda GOOGLE_DRIVE_* por legado.
# Opt-in: default false. Ligue APENAS depois de definir a chave e a pasta.
BACKUP_ENABLED=false
# Chave Fernet EXCLUSIVA do backup (LGPD: o dump carrega PII e NUNCA sai do
# VPS em claro). Gerar com:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# AVISO: guarde uma cópia da chave FORA do servidor (cofre/senha gerenciada).
# PERDER A CHAVE = PERDER TODOS OS BACKUPS (não há como decifrar sem ela).
# Não reusar PII_ENCRYPTION_KEY — rotacionar uma não pode invalidar a outra.
BACKUP_ENCRYPTION_KEY=
# ID da pasta do Google Drive que recebe os backups (o trecho após /folders/
# na URL da pasta). A rotação só apaga arquivos com prefixo ejc_backup_ nela.
BACKUP_DRIVE_FOLDER_ID=
# auto | service_account | oauth | inherit. Recomendado: service_account.
BACKUP_GOOGLE_DRIVE_AUTH_MODE=auto
# JSON em uma linha OU caminho montado somente leitura; configure apenas um.
BACKUP_GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
BACKUP_GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
# Alternativa OAuth exclusiva: authorized_user JSON/arquivo OU trio abaixo.
BACKUP_GOOGLE_DRIVE_OAUTH_USER_JSON=
BACKUP_GOOGLE_DRIVE_OAUTH_USER_FILE=
BACKUP_GOOGLE_DRIVE_OAUTH_CLIENT_ID=
BACKUP_GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
BACKUP_GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN=
# Horário DIÁRIO do job em UTC ("HH:MM"). 05:00 UTC = 02:00 em Brasília.
BACKUP_HORA_UTC=05:00
# Retenção no Drive: mantém N dias de backups; mais antigos são apagados.
# 30 dias — decisão registrada em docs/auditoria/decisoes-bloco0-2026-08-08.md.
BACKUP_RETENCAO_DIAS=30
# Teto do tar.gz de uploads (MB); acima disto o backup segue só com o banco.
BACKUP_UPLOADS_MAX_MB=512
# Teto do dump do banco (MB) — a cifragem é em memória; acima disto o backup
# falha com erro claro (e alerta) em vez de estourar a RAM do VPS.
BACKUP_DB_MAX_MB=2048
# Timeout do pg_dump em segundos (bancos maiores podem precisar de mais).
BACKUP_PG_DUMP_TIMEOUT=600
# Destino OFFSITE dos artefatos cifrados: gdrive (Google Drive, fluxo original)
# ou rclone (qualquer remote rclone — ex.: OneDrive). O ciclo local cifrado é
# idêntico nos dois modos; ver seção rclone no runbook do backup.
BACKUP_DESTINO=gdrive
# Remote rclone quando BACKUP_DESTINO=rclone (ex.: "onedrive:EJC-Backups").
# Requer `rclone config` feito na VPS e o binário rclone no PATH.
BACKUP_RCLONE_REMOTE=
# Timeout (segundos) de cada `rclone copyto` — links lentos podem exigir mais.
BACKUP_RCLONE_TIMEOUT=300
# true = falha offsite derruba o backup e bloqueia o deploy (fail-closed).
# false (default) = a prova LOCAL cifrada basta para o gate de deploy;
# offsite falho vira status "parcial" com AVISO GRAVE no log — corrija logo.
BACKUP_OFFSITE_OBRIGATORIO=false
# Backup legado local (job 02h00): diretório de dumps e rotação por idade.
BACKUP_DIR=/app/backups
BACKUP_RETENTION_DAYS=7

# ── Índices oficiais BCB (services/indices_service.py + routers/indices.py) ──
# API pública do Banco Central, GRATUITA e sem chave: correção monetária
# (IPCA, INPC, IGP-M, IPCA-15, IPCA-E, TR, poupança), Taxa Legal da Lei
# 14.905/2024 (série 29543), Selic EC 113/2021, taxas de juros por
# instituição/modalidade (revisional bancária) e PTAX. Cache persistente na
# tabela indices_bcb_cache (criada automaticamente — sem migration).
# LIGADO por padrão (não há custo; autorizado pelo dono).
INDICES_BCB_ENABLED=true
# Timeout (segundos) das chamadas ao BCB (SGS e Olinda).
INDICES_BCB_TIMEOUT=20

# ── Feriados nacionais via BrasilAPI (services/feriados_service.py) ──────────
# Job semanal (segunda 00h15) sincroniza os feriados NACIONAIS do ano corrente
# e do próximo para a tabela `feriados` usada no cálculo de prazos. Merge
# aditivo: feriados municipais/estaduais cadastrados à mão NUNCA são alterados.
# Gratuito, sem chave — ligado por padrão.
FERIADOS_BRASILAPI_ENABLED=true

# ── Radar Legislativo — Câmara + Senado + ALMG (services/radar_legislativo.py)
# Job diário (07h00 UTC) monitora proposições legislativas por termos derivados
# dos ramos ATIVOS do escritório (tabela `areas`) e alimenta o Radar
# Regulatório (alertas em diario_oficial_alertas + sino interno advogado+).
# APIs públicas gratuitas, sem chave — LIGADO por padrão. Dedup persistente na
# tabela radar_legislativo_visto (criada automaticamente — sem migration).
# Timeouts calibrados pela sondagem (docs/CATALOGO_APIS_EJC.md): Câmara 30s,
# Senado 20s, ALMG 45s com degradação total (falha da ALMG nunca derruba o job).
RADAR_LEGISLATIVO_ENABLED=true
# Termos customizados por ramo (JSON em UMA linha): {"ramo": ["termo", ...]}.
# Sobrepõe os termos default do ramo; ramos fora da taxonomia são aditivos.
# Ex.: RADAR_LEGISLATIVO_TERMOS={"tributario": ["CBS IBS", "split payment"]}
RADAR_LEGISLATIVO_TERMOS=

# ── Seeds — forçar re-seed no boot (seeds/skills_seed.py, templates_seed.py) ─
# Default false: o seed é idempotente e NÃO sobrescreve registros já editados.
# true = atualiza skills/templates existentes para a versão do código (útil
# após deploy que muda o conteúdo seedado). Voltar para false depois.
FORCE_SKILLS_UPDATE=false
FORCE_TEMPLATES_UPDATE=false

# ── IA — custo estimado (services/ai_cost.py) ────────────────────────────────
# Cotação USD→BRL para converter a tabela de preços Anthropic (USD) no custo
# em R$ do dashboard de IA. Default 5.70 se não definida.
USD_BRL_RATE=5.70

# ── Google Drive — GED de documentos por caso (routers/documents.py) ─────────
# ID da pasta-raiz do Drive onde /documents/drive/upload cria subpastas de caso.
GOOGLE_DRIVE_FOLDER_ID=
# A criação de subpastas usa a credencial canônica GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON
# (seção Google Drive acima); GOOGLE_DRIVE_SA_JSON é aceito como alias legado.

ESCRITORIO_NOME=De Paula Teixeira Sociedade de Advogados
# PENDÊNCIA (auditoria jul/2026): o CNPJ que ficava fixo aqui e no código
# (32.491.468/0001-12) resolvia para OUTRA razão social na Receita Federal.
# Confirmar o CNPJ correto da sociedade na Receita e preencher abaixo; vazio,
# o segmento CNPJ é omitido do timbre dos documentos e a pendência aparece no
# log de boot e na Central de Diagnóstico.
ESCRITORIO_CNPJ=
ESCRITORIO_CIDADE=Betim
ESCRITORIO_ESTADO=MG
ESCRITORIO_EMAIL=contato@depaulateixeira.adv.br
# Dados FIXOS do escritório usados no timbre/procuração/contrato de todos os
# documentos gerados. Deixe em branco e o SEGMENTO INTEIRO é omitido do timbre
# (nada de placeholder no documento do cliente — a pendência vai para o log de
# boot); preencha aqui para que TODAS as peças (PDF, DOCX, procuração,
# contrato de honorários) usem o valor automaticamente.
ESCRITORIO_OAB=
ESCRITORIO_ENDERECO=
ESCRITORIO_CEP=

# ── Variáveis existentes em config.py que não estavam documentadas aqui ───────
# (paridade garantida por backend/tests/test_env_example_paridade.py — análise
# E2E 03/09/2026, F3). Defaults iguais aos do código; ajuste só se precisar.

# Núcleo de IA — grounding ao vivo, agente e orçamento
# confere jurisprudência/legislação ao vivo nas tarefas de mérito
AI_LIVE_GROUNDING_ENABLED=true
# grounding também no DataJud (exige DATAJUD_* configurado)
AI_GROUNDING_DATAJUD_ENABLED=false
# teto de custo por execução do agente
AI_AGENT_MAX_CUSTO_BRL=2.0
# validade do token de retomada HITL do agente
AI_AGENT_HITL_TTL_SEGUNDOS=900
# deadline agregado da cadeia de provedores (uma request nunca passa disso)
AI_CHAIN_DEADLINE_SECONDS=240
# dossiê de contexto do caso: teto por seção
AI_CONTEXTO_MAX_CHARS_SECAO=6000
# dossiê de contexto do caso: teto total
AI_CONTEXTO_MAX_CHARS=60000
# RAG — busca, rerank e auto-reindex
OLLAMA_TIMEOUT=180
# similaridade mínima na busca vetorial
RAG_MIN_SIM=0.55
# pool mínimo enviado ao reranker
RAG_RERANK_POOL_MIN=20
# pool = top_k × este fator
RAG_RERANK_POOL_MULT=5
# job horário que vetoriza chunks órfãos
RAG_AUTO_REEMBED_ENABLED=true
RAG_AUTO_REEMBED_BATCH=20
# teto de chunk = janela do modelo de embedding (e5-large ≈ 512 tokens)
EMBEDDINGS_MAX_CHARS=1800
# o seed vetoriza a base inicial ao final (busca semântica útil desde o 1º boot)
SEED_EMBED_ORFAOS=true

# Peças — modos de produção controlados
PECAS_AUTOCRITICA_ENABLED=false
PECAS_PESQUISA_QUESTOES_ENABLED=false
PECAS_RAG_MODELOS_ENABLED=true
PECAS_RAG_MODELOS_TOPK=3
# Entrada Única — expurgo de rascunhos
FICHA_TRIAGEM_OBRIGATORIA=true
ENTRADA_EXPURGO_ENABLED=false
# Portal da Transparência / CGU (integração desligada por padrão)
ENTRADA_EXPURGO_DIAS=30
TRANSPARENCIA_ENABLED=false
TRANSPARENCIA_API_KEY=
# NFS-e — defaults fiscais (deixe vazio para o valor do código)
TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
NFSE_REGIME_TRIBUTARIO=
NFSE_TIPO_RETENCAO_ISS_DEFAULT=
# Observabilidade
NFSE_TRIB_ISSQN_DEFAULT=
SENTRY_ENVIRONMENT=production
# Sessão / 2FA
SENTRY_TRACES_SAMPLE_RATE=0.0
REFRESH_TOKEN_EXPIRE_DAYS=7
# Scheduler e poda de rotas
TWO_FACTOR_SETUP_TOKEN_EXPIRE_MINUTES=15
# tolerância para disparo perdido (restart no horário do job)
SCHEDULER_MISFIRE_GRACE_SECONDS=3600
# CSV "METODO /api/caminho" (sufixo * = prefixo) → header Deprecation
API_ROTAS_DEPRECIADAS=
# data HTTP enviada em `Sunset` para as rotas acima
API_ROTAS_SUNSET=
