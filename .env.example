APP_ENV=production
DEBUG=false

POSTGRES_USER=ejc_user
POSTGRES_PASSWORD=TROCAR_POR_SENHA_FORTE
POSTGRES_DB=ejc_db

SECRET_KEY=TROCAR_POR_CHAVE_ALEATORIA_LONGA
CORS_ORIGINS=https://seu-dominio.com.br,http://seu-ip
FRONTEND_URL=https://seu-dominio.com.br

# PII em repouso (LGPD) — OBRIGATÓRIAS em produção (o app NÃO as gera sozinho
# quando APP_ENV=production). Sem elas, cpf/cnpj cifrados quebram.
#   PII_ENCRYPTION_KEY: chave Fernet (32 bytes url-safe base64). Gere com:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PII_HASH_KEY: gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_ENCRYPTION_KEY=TROCAR_POR_CHAVE_FERNET
PII_HASH_KEY=TROCAR_POR_CHAVE_ALEATORIA

# Usuário admin inicial (criado pelo seeds/seed_all.py no 1º boot, idempotente).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e impressa UMA vez
# no log do container (docker compose logs backend). must_change_password=True.
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_NAME=Administrador EJC
ADMIN_PASSWORD=TROCAR_POR_SENHA_FORTE_INICIAL

AI_ENABLED=false
AI_PROVIDER=auto
GROQ_API_KEY=
# Chave da API Anthropic (Claude) — cole aqui o valor real (sk-ant-...).
# Sem ela o Claude fica indisponivel e a IA cai para Groq. NUNCA versionar.
ANTHROPIC_API_KEY=
# Modelos Claude (opcional). RAPIDO = Haiku (barato); COMPLEXO = Opus 4.8
# (maxima qualidade juridica, $5/$25 por 1M tokens — o prompt caching reduz
# leituras repetidas a ~10%). Para reduzir custo: claude-sonnet-5 ($3/$15).
ANTHROPIC_MODEL_RAPIDO=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_COMPLEXO=claude-opus-4-8
# Profundidade de raciocinio nos modelos modernos: low | medium | high
ANTHROPIC_EFFORT=high

# ── IA — Núcleo Único (policy central de provedores) ────────────────────────
# Liga/desliga o provider Anthropic sem remover a chave.
ANTHROPIC_ENABLED=true
# Timeout do client Anthropic em segundos.
ANTHROPIC_TIMEOUT_SECONDS=120
# Teto duro de tokens de saida por chamada (controle de custo).
# Nos modelos modernos (Opus 4.7+/Sonnet 5) o thinking adaptativo exige piso
# de 8192 — o teto efetivo nesses modelos e max(ANTHROPIC_MAX_TOKENS, 8192).
ANTHROPIC_MAX_TOKENS=8000
# false = so Ollama local; nenhum dado sai do VPS (Anthropic/Groq inelegiveis).
AI_EXTERNAL_PROVIDERS_ALLOWED=true
# true = sanitizacao LGPD obrigatoria antes de qualquer provider externo.
# NUNCA desligar em producao sem parecer do encarregado de dados.
AI_REQUIRE_SANITIZATION_FOR_EXTERNAL=true
# true = toda saida de IA e rascunho com revisao humana obrigatoria (OAB).
AI_REQUIRE_HITL=true
# Ordem de preferencia entre provedores elegiveis (csv).
AI_PROVIDER_PRIORITY=ollama,anthropic,groq

DATAJUD_ENABLED=false
DATAJUD_API_KEY=

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

WHATSAPP_ENABLED=false
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@depaulateixeira.adv.br

ENABLE_SCHEDULER=true
MAX_UPLOAD_MB=50

ESCRITORIO_NOME=De Paula Teixeira Sociedade de Advogados
ESCRITORIO_CNPJ=32.491.468/0001-12
ESCRITORIO_CIDADE=Betim
ESCRITORIO_ESTADO=MG
ESCRITORIO_EMAIL=contato@depaulateixeira.adv.br
