# ══════════════════════════════════════════════════════════════════
# EJC v3.0 — Variáveis de ambiente
# Copie para .env e preencha:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ── Aplicação ─────────────────────────────────────────────
APP_ENV=production
DEBUG=false

# ── Segurança (OBRIGATÓRIO trocar) ────────────────────────
# Gerar: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=TROCAR_POR_CHAVE_ALEATORIA_DE_64_CHARS
ACCESS_TOKEN_EXPIRE_HOURS=8
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Banco de dados ────────────────────────────────────────
POSTGRES_USER=ejc_user
POSTGRES_PASSWORD=TROCAR_SENHA_FORTE_DO_BANCO
POSTGRES_DB=ejc_db
# (DATABASE_URL e DATABASE_URL_SYNC são montadas pelo docker-compose)

# ── CORS — domínio do frontend em produção ────────────────
CORS_ORIGINS=https://ejc.depaulateixeira.adv.br

# ── Upload ────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=50

# ── IA — Groq (https://console.groq.com → API Keys) ───────
# Dados são SANITIZADOS (CPF/CNPJ/nomes removidos) antes do envio — LGPD
GROQ_API_KEY=
GROQ_MODEL=llama3-70b-8192
GROQ_TIMEOUT=60
AI_ENABLED=true

# ── WhatsApp — Z-API (https://z-api.io) ───────────────────
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
WHATSAPP_ENABLED=false

# ── E-mail SMTP (opcional) ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENABLED=false

# ── Scheduler (Morning Brief + alertas) ───────────────────
# true APENAS no worker único. Dockerfile já usa --workers 1.
ENABLE_SCHEDULER=true

# ── Seed inicial (primeiro deploy) ────────────────────────
ADMIN_EMAIL=admin@seuescritorio.com.br
ADMIN_PASSWORD=SenhaForteAqui@2024

# ── v3.x — Funcionalidades expandidas ─────────────────────
# URL pública (links de e-mail: reset de senha, alertas)
FRONTEND_URL=https://ejc.depaulateixeira.adv.br

# DJEN — captura de intimações por OAB (API pública CNJ, sem chave)
# Configure a OAB de cada advogado na tela Usuários
# (campos: djen_oab_numero + djen_oab_uf)

# DataJud — consulta processual (chave pública do CNJ já embutida)
DATAJUD_ENABLED=true

# Busca semântica local (intfloat/multilingual-e5-base, 768d, multilingual)
# Requer: pip install -r requirements-ml.txt
# Sem isso a busca cai para modo textual (ILIKE) — funcional mas menos precisa
EMBEDDINGS_ENABLED=true

# Web Push (alertas no celular) — gere as chaves:
#   docker compose exec backend python scripts/gen_vapid.py
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@seuescritorio.com.br

# Backup offsite (opcional): nome do remote rclone (ex: b2:ejc-backups)
# Instale rclone no HOST: curl https://rclone.org/install.sh | sudo bash
BACKUP_REMOTE=

# ── IA — modelo de contexto longo (Groq) ──────────────────
# Usado automaticamente quando o prompt ultrapassa 20 000 chars (dossiê grande)
GROQ_MODEL_LARGE=llama-3.1-70b-versatile

# ── Ollama — modelos locais (soberania total, sem custo por token) ─
# Ativar: OLLAMA_ENABLED=true + docker compose --profile ollama up -d ollama
# Pull dos modelos: docker compose exec ollama ollama pull qwen2.5:14b
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_ANALISE=deepseek-r1:8b
OLLAMA_MODEL_PETICAO=qwen2.5:14b
OLLAMA_MODEL_RESUMO=gemma3:9b
OLLAMA_MODEL_CHAT=gemma3:9b
OLLAMA_MODEL_CONTRATO=deepseek-r1:8b
OLLAMA_TIMEOUT=180

# Seleção do provedor de IA:
# "auto" = Ollama se disponível, senão Groq (recomendado)
# "groq"  = força Groq (nuvem, exige GROQ_API_KEY)
# "ollama" = força Ollama (local, falha se indisponível)
AI_PROVIDER=auto

# ── Sentry — rastreamento de erros em produção ────────────
# Obter DSN em sentry.io (plano gratuito suficiente)
SENTRY_DSN=

# ── Fase 2 — Módulos avançados ────────────────────────────
# Auditoria de processos esquecidos (segunda-feira 08h15, via Scheduler)
# Sem configuração extra — funciona automaticamente com ENABLE_SCHEDULER=true

# Visual Law — Mermaid.js diagrams (gerado pela IA, sem deps extras)
# Endpoints: POST /api/ai/caso/{id}/visual-law?tipo=timeline|fluxo_status|partes|prazos

# Dual-IA — disponível via: POST /api/ai/caso/{id}/dual
# IA 1 analisa, IA 2 audita. Ambos HITL obrigatório.

# Biblioteca de Prompts — POST /api/prompts-juridicos
# Atendimentos ao Cliente — GET/POST /api/atendimentos
# Jurimetria — GET /api/jurimetria/overview|por-area|por-magistrado|por-tribunal|por-tese
