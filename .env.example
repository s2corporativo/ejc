APP_ENV=production
DEBUG=false

POSTGRES_USER=ejc_user
POSTGRES_PASSWORD=TROCAR_POR_SENHA_FORTE
POSTGRES_DB=ejc_db

SECRET_KEY=TROCAR_POR_CHAVE_ALEATORIA_LONGA
CORS_ORIGINS=https://seu-dominio.com.br,http://seu-ip
FRONTEND_URL=https://seu-dominio.com.br

# PII em repouso (LGPD) — OBRIGATÓRIAS em produção (o app NÃO as gera sozinho
# quando APP_ENV=production). Sem elas, cpf/cnpj cifrados quebram.
#   PII_ENCRYPTION_KEY: chave Fernet (32 bytes url-safe base64). Gere com:
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   PII_HASH_KEY: gere com:  python -c "import secrets; print(secrets.token_urlsafe(32))"
PII_ENCRYPTION_KEY=TROCAR_POR_CHAVE_FERNET
PII_HASH_KEY=TROCAR_POR_CHAVE_ALEATORIA

# Usuário admin inicial (criado pelo seeds/seed_all.py no 1º boot, idempotente).
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e impressa UMA vez
# no log do container (docker compose logs backend). must_change_password=True.
ADMIN_EMAIL=admin@seu-dominio.com.br
ADMIN_NAME=Administrador EJC
ADMIN_PASSWORD=TROCAR_POR_SENHA_FORTE_INICIAL

AI_ENABLED=true
AI_PROVIDER=auto
GROQ_API_KEY=
# Chave da API Anthropic (Claude) — cole aqui o valor real (sk-ant-...).
# Sem ela o Claude fica indisponivel e a IA cai para Groq. NUNCA versionar.
ANTHROPIC_API_KEY=
# Modelos Claude (opcional). RAPIDO = Haiku (barato); COMPLEXO = Opus 4.8
# (maxima qualidade juridica, $5/$25 por 1M tokens — o prompt caching reduz
# leituras repetidas a ~10%). Para reduzir custo: claude-sonnet-5 ($3/$15).
ANTHROPIC_MODEL_RAPIDO=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_COMPLEXO=claude-opus-4-8
# Profundidade de raciocinio nos modelos modernos: low | medium | high
ANTHROPIC_EFFORT=high

# ── IA — Núcleo Único (policy central de provedores) ────────────────────────
# Liga/desliga o provider Anthropic sem remover a chave.
ANTHROPIC_ENABLED=true
# Timeout do client Anthropic em segundos.
ANTHROPIC_TIMEOUT_SECONDS=120
# Teto duro de tokens de saida por chamada (controle de custo).
# Nos modelos modernos (Opus 4.7+/Sonnet 5) o thinking adaptativo exige piso
# de 8192 — o teto efetivo nesses modelos e max(ANTHROPIC_MAX_TOKENS, 8192).
ANTHROPIC_MAX_TOKENS=8000
# Governanca de custo: alerta no painel de Governanca da IA quando o gasto
# estimado de IA no periodo exceder este valor (R$). 0 = sem alerta (so exibe).
AI_BUDGET_ALERTA_BRL=0
# false = so Ollama local; nenhum dado sai do VPS (Anthropic/Groq inelegiveis).
AI_EXTERNAL_PROVIDERS_ALLOWED=true
# true = sanitizacao LGPD obrigatoria antes de qualquer provider externo.
# NUNCA desligar em producao sem parecer do encarregado de dados.
AI_REQUIRE_SANITIZATION_FOR_EXTERNAL=true
# Intake de documentos (importacao inteligente):
# true (default) = se o Ollama local estiver indisponivel, a interpretacao do
# documento pode usar provedor externo (Anthropic/Groq, EUA — transferencia
# internacional, art. 33 LGPD). O texto vai SANITIZADO (CPF/CNPJ/OAB/processo
# viram marcadores) e o dado pessoal exato e extraido LOCALMENTE por regex,
# nunca enviado. false = fail-closed: intake so com Ollama local; sem Ollama a
# importacao degrada com erro claro citando esta flag.
INTAKE_EXTERNAL_FALLBACK=true
# true = toda saida de IA e rascunho com revisao humana obrigatoria (OAB).
AI_REQUIRE_HITL=true
# Gate antialucinacao de citacoes: bloquear | marcar | desligado.
# bloquear = aprovacao HITL exige override justificado se houver citacao bloqueante.
# RUNBOOK DE EMERGENCIA: se a verificacao de citacoes quebrar em producao com
# politica=bloquear (aprovacoes HITL retornando 503 com stacktrace no log do
# backend), mude para CITACOES_POLITICA=marcar e REINICIE o backend — o valor
# e lido via get_settings(), que e cacheado; editar o .env sem reiniciar NAO
# tem efeito. Depois investigue o stacktrace e retorne para "bloquear".
CITACOES_POLITICA=marcar
# Ordem de preferencia entre provedores elegiveis (csv).
AI_PROVIDER_PRIORITY=ollama,anthropic,groq
# Niveis de sanitizacao de PII por tipo de tarefa (LGPD art. 33/46).
# JSON OPCIONAL task_type->modo que SOBREPOE o default (revisavel por Dr. Clovis)
# em app/services/ai/sanitization_policy.py. Modos:
#   local_completo         = so Ollama local; conteudo NUNCA vai a externo.
#   externo_pseudonimizado = pseudonimiza reversivel -> externo -> reidrata.
#   extracao_local         = extracao estruturada local (importacao/OCR).
#   mascaramento           = mascaramento irreversivel (legado/fallback).
# Vazio = usa o default. Fail-safe: JSON invalido/modo desconhecido -> default.
# Ex.: AI_SANITIZATION_MODE_MAP={"familia":"local_completo","triagem":"mascaramento"}
AI_SANITIZATION_MODE_MAP=

# ── Fase 6 — Roteamento inteligente por complexidade/custo ──────────────────
# OFF por padrão = comportamento atual por task_type intacto. Quando ON, o
# model_router (heurística DETERMINÍSTICA, sem IA) propõe o provedor de PARTIDA
# da cadeia por complexidade do input. O gateway AINDA aplica elegibilidade/
# kill-switch/barreira PII e o fallback — o roteador só PROPÕE.
ROTEAMENTO_INTELIGENTE_ENABLED=true
ROTEAMENTO_PROVIDER_LEVE=groq
# medio = anthropic (Haiku): o stack de producao nao sobe ollama.
ROTEAMENTO_PROVIDER_MEDIO=anthropic
ROTEAMENTO_PROVIDER_PESADO=anthropic
# Validacao adversarial (2a IA critica) nas pecas de alta complexidade.
DUAS_IAS_ENABLED=true
ROTEAMENTO_LIMIAR_MEDIO=3
ROTEAMENTO_LIMIAR_PESADO=6

# ── Fase 6 — Observabilidade de IA (Langfuse SELF-HOSTED) ───────────────────
# Langfuse é SELF-HOSTED (docker-compose --profile observability). Dados
# jurídicos NÃO saem do ambiente — NUNCA apontar para cloud.langfuse.com.
# OFF por padrão: wrapper NO-OP total (não importa SDK, não conecta) e o fluxo
# de IA nunca quebra por causa do tracing.
# Primeira subida: `docker compose --profile observability up -d langfuse` e
# criar projeto/chaves na UI (http://SEU_HOST:3000). Cole as chaves abaixo.
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LGPD: por padrão SÓ metadados (task_type, provider, modelo, tokens, latência,
# custo, sucesso/erro) vão ao Langfuse — NUNCA prompt/resposta crus. Ligar True
# envia conteúdo APÓS a MESMA sanitização PII do gateway. Não ligar sem DPO.
LANGFUSE_CAPTURE_CONTENT=false
# Segredos do Langfuse self-hosted (só usados pelo serviço no compose):
LANGFUSE_DB_PASSWORD=troque_esta_senha
LANGFUSE_NEXTAUTH_SECRET=troque_gere_com_openssl_rand_base64_32
LANGFUSE_SALT=troque_gere_com_openssl_rand_base64_32
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# ── Ollama — modelos locais (soberania total, sem custo por token) ──────────
# Ligado por padrão: se não houver serviço Ollama acessível em
# OLLAMA_BASE_URL, a cadeia de fallback do ai_gateway (chat()/_resolver_cadeia)
# detecta a falha rapidamente (conexão recusada/DNS) e segue para o próximo
# provedor elegível (Anthropic/Groq) sem quebrar a requisição do usuário.
# Para provisionar o container local: docker compose --profile ia-local up -d
# (ou scripts/subir-ia-local.sh). Com o profile DESLIGADO nada muda no `up`
# padrão — a cadeia segue caindo para Anthropic/Groq automaticamente.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434

# Modelos que o serviço one-shot `ollama-init` baixa (CSV). FONTE ÚNICA da
# lista de pulls — mantenha em sincronia com os OLLAMA_MODEL_* abaixo.
OLLAMA_PULL_MODELS=deepseek-r1:8b,qwen2.5:14b,gemma3:9b
# Teto de RAM do container ollama (mem_limit) e tempo que o modelo fica
# carregado após ociosidade antes de liberar a RAM.
OLLAMA_MEM_LIMIT=12g
OLLAMA_KEEP_ALIVE=10m

# ── Perfis de hardware prontos (descomente UM bloco e ajuste) ────────────────
# RAM aproximada por modelo em CPU (sem GPU): llama3.2:3b/qwen2.5:3b ≈ 3-4GB;
# deepseek-r1:8b/gemma3:9b ≈ 6-7GB; qwen2.5:14b ≈ 10-11GB. O compose limita o
# container a OLLAMA_MEM_LIMIT e carrega 1 modelo por vez. Se o Ollama estiver
# indisponível ou estourar o timeout, a cadeia do ai_gateway cai para
# Anthropic/Groq automaticamente — nada quebra; só deixa de ser custo zero.
#
# (a) VPS modesta — 8 GB de RAM total (deixa ~4 GB para app+banco):
# OLLAMA_PULL_MODELS=llama3.2:3b
# OLLAMA_MEM_LIMIT=5g
# OLLAMA_MODEL_ANALISE=llama3.2:3b
# OLLAMA_MODEL_PETICAO=llama3.2:3b
# OLLAMA_MODEL_RESUMO=llama3.2:3b
# OLLAMA_MODEL_CHAT=llama3.2:3b
# OLLAMA_MODEL_CONTRATO=llama3.2:3b
#
# (b) Servidor 16 GB+ — modelos padrão do config.py (nada a sobrescrever):
# OLLAMA_PULL_MODELS=deepseek-r1:8b,qwen2.5:14b,gemma3:9b
# OLLAMA_MEM_LIMIT=12g
# OLLAMA_MODEL_ANALISE=deepseek-r1:8b   # análise jurídica profunda
# OLLAMA_MODEL_PETICAO=qwen2.5:14b      # elaboração de peças
# OLLAMA_MODEL_RESUMO=gemma3:9b         # resumos rápidos
# OLLAMA_MODEL_CHAT=gemma3:9b           # chat e perguntas simples
# OLLAMA_MODEL_CONTRATO=deepseek-r1:8b  # análise contratual

# ── DataJud/CNJ — API Pública (consulta de andamentos processuais) ───────────
# Integração externa é OPT-IN: desligada por padrão.
DATAJUD_ENABLED=false
# Chave PÚBLICA de uso geral divulgada pelo CNJ na wiki oficial:
# https://datajud-wiki.cnj.jus.br/api-publica/acesso/ (header "Authorization: APIKey <chave>").
# Nunca commitar a chave; ela não aparece em logs nem em mensagens de erro.
DATAJUD_API_KEY=
# Host oficial da API Pública (POST /{alias_tribunal}/_search). Só mude para testes.
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# ── TJMG — coletor de jurisprudência estadual MG → RAG (crawler agendado) ────
# O TJMG não tem API aberta: a coleta depende de scraping do formulário HTML.
# Desligado por padrão — LIGUE só após validar o retorno contra o site real
# (o painel /ia-governanca/fontes mostra novos/total/erro da fonte "tjmg").
# Job semanal (sáb 04h30), gated por ENABLE_SCHEDULER + TJMG_INGEST_ENABLED.
TJMG_INGEST_ENABLED=false
# Temas de busca (CSV). Vazio = lista padrão das áreas do escritório.
# Ex.: TJMG_INGEST_TEMAS=dano moral,plano de saúde,revisional bancário
TJMG_INGEST_TEMAS=
# Janela (dias p/ trás) do filtro de data de julgamento. 0 = sem filtro.
TJMG_INGEST_JANELA_DIAS=30
# Teto de acórdãos por tema/execução (controle de volume e de carga no portal).
TJMG_INGEST_MAX_POR_TEMA=50

# ── Busca semântica do RAG (embeddings locais, sem serviço http) ─────────────
# Ligado por padrão: EMBEDDINGS_PROVIDER=local usa fastembed (dependência
# pinada no requirements.txt), sem serviço externo. O modelo
# (paraphrase-multilingual-mpnet-base-v2, 768d via fastembed/ONNX, ~1GB) é
# baixado na PRIMEIRA chamada de embedding — não trava o boot.
# Desligado ou em erro, o RAG cai para busca textual (fallback gracioso —
# gerar_embeddings() nunca levanta exceção, ver embedding_service.py).
# EMBEDDINGS_PROVIDER=http (+ EMBEDDINGS_API_URL) só se existir container
# dedicado de embeddings — NÃO é necessário para o modo local.
EMBEDDINGS_ENABLED=true
EMBEDDINGS_PROVIDER=local

EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

WHATSAPP_ENABLED=false
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@depaulateixeira.adv.br

ENABLE_SCHEDULER=true
MAX_UPLOAD_MB=50

# Backup automático (scheduler.py, job das 02h00: pg_dump do banco em BACKUP_DIR).
# BACKUP_REMOTE = destino OFFSITE do backup via rclone (ex.: um remote já
# configurado com `rclone config`, como "gdrive:ejc-backups" ou "s3:bucket/ejc").
# Vazio (default) = backup só local no volume; nenhum upload offsite é feito.
# Requer o binário `rclone` disponível no ambiente e o remote configurado.
BACKUP_REMOTE=

# ── Backup diário cifrado → Google Drive (services/backup_service.py) ────────
# Reusa as credenciais Google da curadoria de conhecimento (GOOGLE_DRIVE_* já
# cadastradas acima) — nenhum fluxo novo de auth. O consentimento/compartilha-
# mento do Google precisa permitir ESCRITA na pasta de backup (o client do RAG
# é somente-leitura; o de backup re-escopa para escrita).
# Opt-in: default false. Ligue APENAS depois de definir a chave e a pasta.
BACKUP_ENABLED=false
# Chave Fernet EXCLUSIVA do backup (LGPD: o dump carrega PII e NUNCA sai do
# VPS em claro). Gerar com:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# AVISO: guarde uma cópia da chave FORA do servidor (cofre/senha gerenciada).
# PERDER A CHAVE = PERDER TODOS OS BACKUPS (não há como decifrar sem ela).
# Não reusar PII_ENCRYPTION_KEY — rotacionar uma não pode invalidar a outra.
BACKUP_ENCRYPTION_KEY=
# ID da pasta do Google Drive que recebe os backups (o trecho após /folders/
# na URL da pasta). A rotação só apaga arquivos com prefixo ejc_backup_ nela.
BACKUP_DRIVE_FOLDER_ID=
# Horário DIÁRIO do job em UTC ("HH:MM"). 05:00 UTC = 02:00 em Brasília.
BACKUP_HORA_UTC=05:00
# Retenção no Drive: mantém N dias de backups; mais antigos são apagados.
BACKUP_RETENCAO_DIAS=14
# Teto do tar.gz de uploads (MB); acima disto o backup segue só com o banco.
BACKUP_UPLOADS_MAX_MB=512
# Teto do dump do banco (MB) — a cifragem é em memória; acima disto o backup
# falha com erro claro (e alerta) em vez de estourar a RAM do VPS.
BACKUP_DB_MAX_MB=2048

ESCRITORIO_NOME=De Paula Teixeira Sociedade de Advogados
ESCRITORIO_CNPJ=32.491.468/0001-12
ESCRITORIO_CIDADE=Betim
ESCRITORIO_ESTADO=MG
ESCRITORIO_EMAIL=contato@depaulateixeira.adv.br
