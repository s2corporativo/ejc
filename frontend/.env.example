# ── Variáveis públicas do frontend EJC (Vite) ────────────────────────────
# ATENÇÃO: tudo com prefixo VITE_ entra no bundle servido ao navegador.
# Aqui só entra dado PÚBLICO — jamais credencial, token ou URL com segredo.
# Fonte única de consumo: src/config/office.ts.

# Telefone do WhatsApp institucional (DDI+DDD+número; máscara é tolerada,
# só os dígitos são usados). Sem valor, o botão de WhatsApp não aparece.
VITE_EJC_WHATSAPP_NUMBER=

# E-mail de contato institucional. Sem valor, o botão de e-mail não aparece.
VITE_EJC_CONTACT_EMAIL=

# URL do ambiente de IA usado pelo escritório (botão "IA do Escritório").
# Padrão: https://claude.ai — nunca embuta login/senha na URL.
VITE_EJC_OFFICE_AI_URL=

# Fuso horário da hora/data do cabeçalho (IANA). Padrão: America/Sao_Paulo.
VITE_EJC_TIMEZONE=
