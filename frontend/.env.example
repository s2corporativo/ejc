# Configurações públicas do frontend EJC.
# Não inserir tokens, senhas, cookies, chaves de API ou credenciais nestas variáveis.

VITE_EJC_OFFICE_NAME=EJC DePaula Teixeira Adv
VITE_EJC_LOGO_PATH=/brand/de-paula-teixeira-dt.png

# Somente dígitos, com DDI e DDD. Exemplo de formato: 5531999999999
VITE_EJC_WHATSAPP_NUMBER=
VITE_EJC_CONTACT_EMAIL=

VITE_EJC_TIMEZONE=America/Sao_Paulo

# Mensagem auditável exibida no cabeçalho. A referência deve identificar a fonte real.
VITE_EJC_DAILY_MESSAGE=Organização, clareza e responsabilidade em cada decisão.
VITE_EJC_DAILY_MESSAGE_SOURCE=Mensagem institucional
