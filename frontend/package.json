{
  "name": "ejc-frontend",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.{ts,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:responsive": "node tests/responsividade.mjs",
    "test:shell-responsive": "node tests/shell-dashboard-responsividade.mjs && node tests/shell-reduced-motion.mjs",
    "audit:css": "node scripts/auditar-css.mjs",
    "audit:css:verificar": "node scripts/auditar-css.mjs --verificar",
    "test:navegacao": "node tests/navegacao-registry.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "types:gerar": "cd ../backend && APP_ENV=development python scripts/gerar_tipos_frontend.py",
    "types:check": "cd ../backend && APP_ENV=development python scripts/gerar_tipos_frontend.py --check"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^1.29.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "postcss": "8.5.25",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
