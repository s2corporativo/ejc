FROM node:22-bookworm-slim

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       ca-certificates \
       git \
       python3 \
       python3-pip \
       python3-venv \
       ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 agente \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/sh agente \
    && mkdir -p /workspace \
    && chown agente:agente /workspace

ENV HOME=/home/agente \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace
USER agente

CMD ["sh", "-c", "while :; do sleep 3600; done"]
