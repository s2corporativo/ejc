# Dependencies
node_modules/
# O frontend é instalado pelo npm (`package-lock.json`) no Docker e no CI;
# não reintroduzir um segundo lockfile pnpm com resolução divergente.
frontend/pnpm-lock.yaml

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
.ENV
.ENV.local

# Build outputs
dist/
build/
*.egg-info/

# Logs
*.log

# Environment specific
.env
.env.local
.env.*
# `.env.*` acima sombreia os `.env.example` — que são o CONTRATO de
# provisionamento, não segredo, e precisam ser versionáveis. Os 4 que existem
# hoje seguem rastreados (o índice vence o ignore), mas um `.env.example` novo
# (ou reintroduzido depois de um `git rm`) sumiria do `git add` em silêncio.
# Mesma classe do bug de ancoragem corrigido em `/secrets/` mais abaixo.
!.env.example
!**/.env.example

# Editors
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Sobras de merge/patch e backups de editor
*.orig
*.rej
*.bak
*~

# OS generated
.DS_Store
Thumbs.db

# Testing
.coverage
htmlcov/
.coverage.*
.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Relatórios de lint gerados pelo CI — artefato, não fonte
audit/quality/

# Compressed files
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Índice auxiliar do graphify — regenerado pelos hooks de sessão (~190 MB de
# cache AST). É índice, não fonte da verdade: versionar só incharia o repo.
graphify-out/
backend/graphify-out/

# Backups gravados em runtime pelo seed de skills — podem conter dados.
backend/app/seeds/backups/

# Diretórios criados em RUNTIME na raiz do checkout de produção (/opt/ejc).
# Até 2026-08-27 nenhum deles era ignorado: `git status` no VPS listava
# `secrets/` como não rastreado, com credenciais OAuth reais do Google Drive
# dentro (permissão 600, mas a um `git add -A` de distância do repositório
# remoto). Ignorar não é cosmético — é a barreira que impede um comando
# distraído de publicar credencial. NUNCA versione o conteúdo destes.
#
# ANCORADOS NA RAIZ (`/`) DE PROPÓSITO: sem a barra inicial, o Git casa o
# padrão em QUALQUER profundidade e engoliria `backend/app/data/mock_db/`
# (fixtures rastreadas) — um arquivo novo ali sumiria do `git add` em
# silêncio. Só os diretórios da raiz do checkout são runtime.
/secrets/
/backups/
/data/
# Cópia transitória do inventário (scripts/governanca/inventario-repo.sh)
/var/
# Saída de execução do gold set de IA (backend/app/eval/run_gold_ia.py):
# é resultado de rodada, não fonte — o número muda a cada execução.
backend/app/eval/relatorio_gold_ia.json
# Worktrees efêmeros criados por agentes de IA para trabalho isolado.
.claude/worktrees/
