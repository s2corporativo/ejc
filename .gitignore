# ── Segredos / ambiente ──────────────────────────────────────────────
.env
*.env
**/.env
!.env.example
!**/.env.example
vps-tools/.env
.env.bak*
.env.save
**/.env.bak*
**/.env.save

# Chaves e credenciais
*.pem
*.key
*.p12
*.pfx
*-service-account*.json
credentials*.json

# ── Dependências / builds ────────────────────────────────────────────
node_modules/
**/node_modules/
backend/.venv/
backend/.venv-codex/
**/.venv*/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
frontend/dist/
dist/

# ── Artefatos / backups / resíduos (não versionar) ───────────────────
*.tgz
*.tar.gz
*.zip
*.dump
*.sql
*.sql.gz
*.log
uploads/
backups/
frontend/tests/__out__/
_QUARENTENA/
vps-tools/generated/
_session_componentes_bronze/

# Saída de lint/format (o CI já publica como artifact do job; ver ci.yml)
audit/quality/

# Snapshot do grafo de código. O grafo vivo é o graphify-out/, regenerado por
# `graphify update .` e igualmente fora do versionamento.
auditoria-grafo/

# Override local do compose. É arquivo de máquina/VPS — monta ./secrets, que
# não existe no repo. O modelo versionado é docker-compose.override.example.yml.
docker-compose.override.yml
!docker-compose.override.example.yml

# ── Backups locais de arquivos ───────────────────────────────────────
*.bak
*.bak.*
*.old
*.orig

# temporários de deploy (auditoria 01/07)
vps-tools/_*

# graphify — grafo de conhecimento local (regenerável, não versionar)
graphify-out/

# Worktrees efêmeros de subagentes (Claude Code)
.claude/worktrees/
.claude/launch.json
# Permissões locais do agente (por máquina/sessão) — nunca versionar
.claude/settings.local.json
frontend/.claude/

# Segredos aplicados direto na VPS (OAuth Google Drive etc.) — nunca versionar
secrets/

# Artefatos temporários do vps-tools (snapshots/testes manuais de SFTP)
vps-tools/_*

# Arquivos de rollback da reclassificação de área (contêm IDs de casos do
# escritório) — ver RUNBOOK_RECLASSIFICACAO_AREAS.md. Guardar fora do repo.
var/
