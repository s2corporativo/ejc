# Onda #836 — flags de ativação das novas fontes públicas
#
# Todas nascem OFF por regra de governança do EJC. Ative UMA por vez somente
# depois de smoke controlado na VPS. Não há segredo nestas flags.
# Desligar a flag correspondente é o rollback operacional imediato da fonte.

CNJ_SGT_ENABLED=false
TCU_OPEN_DATA_ENABLED=false
IBGE_LOCALIDADES_ENABLED=false
IBAMA_OPEN_DATA_ENABLED=false
CONSUMIDOR_GOV_OPEN_DATA_ENABLED=false
CVM_OPEN_DATA_ENABLED=false
TSE_OPEN_DATA_ENABLED=false
PGFN_OPEN_DATA_ENABLED=false
QUERIDO_DIARIO_ENABLED=false
IDE_SISEMA_ENABLED=false

# Importador de jurisprudência já existente:
# mantenha o valor atual do ambiente. O código da Onda #836 adiciona `tcu`
# automaticamente quando TCU_OPEN_DATA_ENABLED=true, inclusive em VPS antiga
# que preserve JURIS_IMPORT_FONTES=lexml,stj. Quando a flag TCU volta a false,
# `tcu` é removido logicamente mesmo que tenha sido incluído no CSV legado.
#
# JURIS_IMPORT_FONTES=lexml,stj
