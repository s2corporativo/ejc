# Copie para .env (NUNCA versionar o .env) e preencha.
# Depois de preencher: chmod 600 .env

# URL pública do Woodpecker, servida pelo Nginx do host com TLS.
WOODPECKER_HOST=https://ci.depaulateixeira.adv.br

# OAuth App do GitHub (organização s2corporativo):
# github.com > Settings da organização > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:              https://ci.depaulateixeira.adv.br
#   Authorization callback URL: https://ci.depaulateixeira.adv.br/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Segredos independentes. Gere cada um separadamente com: openssl rand -hex 32
# AGENT_SECRET autentica/registra agentes; GRPC_SECRET assina JWTs gRPC.
WOODPECKER_AGENT_SECRET=
WOODPECKER_GRPC_SECRET=

# Datastore administrativo do Woodpecker: a instalação atual usa SQLite.
# O compose serializa o pool por padrão para reduzir concorrência de escrita.
# Só aumente estes valores se a instância for migrada para PostgreSQL ou após
# evidência de que o backend escolhido suporta a concorrência com segurança.
# WOODPECKER_DATABASE_MAX_CONNECTIONS=1
# WOODPECKER_DATABASE_IDLE_CONNECTIONS=1

# Limites por contêiner de pipeline. Defaults do compose: 3 GiB, sem swap extra,
# 1 CPU e prioridade relativa 512. Ajuste só após medir a capacidade da VPS.
# WOODPECKER_JOB_MEMORY_BYTES=3221225472
# WOODPECKER_JOB_MEMORY_SWAP_BYTES=3221225472
# WOODPECKER_JOB_CPU_QUOTA=100000
# WOODPECKER_JOB_CPU_SHARES=512

# Usuário GitHub com poderes de admin no Woodpecker.
WOODPECKER_ADMIN=s2corporativo
