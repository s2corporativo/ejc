# Copie para .env (NUNCA versionar o .env) e preencha.

# URL pública do Woodpecker, servida pelo Nginx do host com TLS.
WOODPECKER_HOST=https://ci.depaulateixeira.adv.br

# OAuth App do GitHub (organização s2corporativo):
# github.com > Settings da organização > Developer settings > OAuth Apps > New OAuth App
#   Homepage URL:              https://ci.depaulateixeira.adv.br
#   Authorization callback URL: https://ci.depaulateixeira.adv.br/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=

# Segredo compartilhado servidor<->agente. Gere com: openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# Usuário GitHub com poderes de admin no Woodpecker.
WOODPECKER_ADMIN=s2corporativo
