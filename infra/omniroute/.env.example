# OmniRoute de manutenção do EJC.
# Copie para .env e mantenha o arquivo local fora do Git.
# O bind em loopback é deliberado: não publicar a interface/API na internet.
OMNIROUTE_BIND_HOST=127.0.0.1
OMNIROUTE_PORT=20128
OMNIROUTE_DISABLE_SQLITE_AUTO_BACKUP=false
OMNIROUTE_REQUIRE_API_KEY=true

# O dashboard precisa de JWT_SECRET para autenticação administrativa.
# Deixe vazio neste modelo: o bootstrap (SECURE_BOOTSTRAP.md) gera um segredo
# forte no host. Com valor vazio ou placeholder, o compose falha de forma
# segura — o dashboard jamais sobe com segredo público conhecido.
OMNIROUTE_JWT_SECRET=
