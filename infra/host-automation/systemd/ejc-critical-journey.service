[Unit]
Description=EJC daily fictitious critical journey
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ejc
ExecStart=/opt/ejc/scripts/run_daily_critical_journey.sh
TimeoutStartSec=20min
Nice=10
