[Unit]
Description=EJC deploy aprovado pelo Woodpecker
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/ejc
ExecStart=/opt/s2-automation/host/ejc-deploy-approved.sh
TimeoutStartSec=120min
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
