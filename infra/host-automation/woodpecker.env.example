# Copiar para /etc/s2-automation/woodpecker.env e manter root:root 0600.
#
# Preferência quando Woodpecker e deploy rodam na MESMA VPS: consultar o
# PostgreSQL local do Woodpecker via docker exec, sem criar token adicional.
# O instalador detecta o container canônico quando ele existe.
WOODPECKER_LOCAL_PG_CONTAINER=

# Fallback legado para instalações que ainda usam SQLite local read-only.
WOODPECKER_LOCAL_DB=

# Fallback para host remoto: token pessoal/dedicado do Woodpecker com acesso
# somente ao necessário para leitura de repos/pipelines. Nunca versione o valor.
WOODPECKER_SERVER_URL=https://ci.depaulateixeira.adv.br
WOODPECKER_TOKEN=TROCAR
